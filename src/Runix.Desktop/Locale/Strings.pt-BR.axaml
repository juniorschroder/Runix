    <sys:String x:Key="Connection.Host">Host</sys:String>
    <sys:String x:Key="Connection.Port">Porta</sys:String>
    <sys:String x:Key="Connection.Database">Nome do Banco de Dados</sys:String>
    <sys:String x:Key="Connection.Username">Usuário</sys:String>
    <sys:String x:Key="Connection.Password">Senha</sys:String>
    <sys:String x:Key="Connection.SslMode">Modo SSL</sys:String>
    <sys:String x:Key="Connection.Test">Testar Conexão</sys:String>

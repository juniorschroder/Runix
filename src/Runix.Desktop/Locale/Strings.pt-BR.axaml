<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <!-- App & Brand -->
    <sys:String x:Key="App.Title">RUNIX</sys:String>
    <sys:String x:Key="App.Subtitle">Database Studio</sys:String>

    <!-- Common Actions & Labels -->
    <sys:String x:Key="Common.Cancel">Cancelar</sys:String>
    <sys:String x:Key="Common.Close">Fechar</sys:String>
    <sys:String x:Key="Common.Save">Salvar</sys:String>
    <sys:String x:Key="Common.Delete">Excluir</sys:String>
    <sys:String x:Key="Common.Refresh">Atualizar</sys:String>
    <sys:String x:Key="Common.Status">Status</sys:String>
    <sys:String x:Key="Common.Loading">Carregando...</sys:String>
    <sys:String x:Key="Common.Error">Erro</sys:String>
    <sys:String x:Key="Common.Success">Sucesso</sys:String>
    <sys:String x:Key="Common.Language">Idioma</sys:String>

    <!-- Connection View -->
    <sys:String x:Key="Connection.SavedConnections">CONEXÕES SALVAS</sys:String>
    <sys:String x:Key="Connection.New">+ Nova</sys:String>
    <sys:String x:Key="Connection.NewCategory">+ Categoria</sys:String>
    <sys:String x:Key="Connection.CategoryLabel">Categoria / Grupo (Opcional)</sys:String>
    <sys:String x:Key="Connection.CategoryWatermark">ex: Produção, Homologação, Cliente X, Local</sys:String>

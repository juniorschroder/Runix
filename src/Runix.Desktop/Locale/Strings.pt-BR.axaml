    <sys:String x:Key="Connection.NewCategoryWatermark">Nome da nova categoria...</sys:String>
    <sys:String x:Key="Connection.AddCategoryBtn">Criar</sys:String>
    <sys:String x:Key="Connection.Title">Configurações de Conexão</sys:String>
    <sys:String x:Key="Connection.Subtitle">Configure os parâmetros de conexão para SQLite ou PostgreSQL</sys:String>
    <sys:String x:Key="Connection.Name">Nome da Conexão</sys:String>
    <sys:String x:Key="Connection.NameWatermark">ex: PostgreSQL Produção, SQLite Analytics</sys:String>
    <sys:String x:Key="Connection.Engine">Motor de Banco de Dados</sys:String>

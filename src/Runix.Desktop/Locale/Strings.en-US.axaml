    <sys:String x:Key="About.CopyInfo">📋 Copy Info</sys:String>
    <sys:String x:Key="About.CopiedStatus">✓ System information copied to clipboard!</sys:String>

    <!-- Auto-Update Notification & Release Inspector -->
    <sys:String x:Key="Update.BadgeTooltip">New RUNIX version available! Click to view details and download.</sys:String>

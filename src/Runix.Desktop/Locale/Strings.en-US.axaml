<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

    <!-- App & Brand -->
    <sys:String x:Key="App.Title">RUNIX</sys:String>
    <sys:String x:Key="App.Subtitle">Database Studio</sys:String>

    <!-- Common Actions & Labels -->
    <sys:String x:Key="Common.Cancel">Cancel</sys:String>
    <sys:String x:Key="Common.Close">Close</sys:String>
    <sys:String x:Key="Common.Save">Save</sys:String>
    <sys:String x:Key="Common.Delete">Delete</sys:String>
    <sys:String x:Key="Common.Refresh">Refresh</sys:String>
    <sys:String x:Key="Common.Status">Status</sys:String>
    <sys:String x:Key="Common.Loading">Loading...</sys:String>
    <sys:String x:Key="Common.Error">Error</sys:String>
    <sys:String x:Key="Common.Success">Success</sys:String>
    <sys:String x:Key="Common.Language">Language</sys:String>

    <!-- Connection View -->

    <sys:String x:Key="Update.DialogSubtitle">A new official release of RUNIX Database Studio is ready for download.</sys:String>
    <sys:String x:Key="Update.CurrentVersionLabel">CURRENT VERSION</sys:String>
    <sys:String x:Key="Update.NewVersionLabel">NEW VERSION</sys:String>
    <sys:String x:Key="Update.ChangelogLabel">RELEASE NOTES (CHANGELOG)</sys:String>

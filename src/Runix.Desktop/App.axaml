<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Runix.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>

        <!-- ============================================== -->
        <!-- RUNIX MODERN BUTTON DESIGN SYSTEM              -->
        <!-- ============================================== -->

        <!-- Base Button Defaults -->
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Primary Accent Button (Brand Blue Glow) -->
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="#008bb9"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#38bdf8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#029cd0"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#7dd3fc"/>
        </Style>
        <Style Selector="Button.btn-primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#007399"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#0284c7"/>
        </Style>

        <!-- Secondary Surface Button (Dark Slate Card) -->
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="#141d2b"/>
            <Setter Property="Foreground" Value="#f0f6fc"/>
            <Setter Property="BorderBrush" Value="#1e2d42"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1e2b40"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#2e4363"/>
        </Style>
        <Style Selector="Button.btn-secondary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0e1520"/>
            <Setter Property="Foreground" Value="#8b9cb3"/>
            <Setter Property="BorderBrush" Value="#141d2b"/>
        </Style>

        <!-- Subtle Blue Accent (Quick actions, sample queries, structure views) -->
        <Style Selector="Button.btn-accent-subtle">
            <Setter Property="Background" Value="#0c2338"/>
            <Setter Property="Foreground" Value="#38bdf8"/>
            <Setter Property="BorderBrush" Value="#16426a"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.btn-accent-subtle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#113250"/>
            <Setter Property="Foreground" Value="#7dd3fc"/>
            <Setter Property="BorderBrush" Value="#1d578c"/>
        </Style>
        <Style Selector="Button.btn-accent-subtle:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#081725"/>
            <Setter Property="Foreground" Value="#0284c7"/>
            <Setter Property="BorderBrush" Value="#123554"/>
        </Style>

        <!-- Outline Button (Clean borders for utility actions) -->
        <Style Selector="Button.btn-outline">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8b9cb3"/>
            <Setter Property="BorderBrush" Value="#1e2d42"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.btn-outline:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#141d2b"/>
            <Setter Property="Foreground" Value="#f0f6fc"/>
            <Setter Property="BorderBrush" Value="#2e4363"/>
        </Style>
        <Style Selector="Button.btn-outline:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0e141f"/>
            <Setter Property="Foreground" Value="#64748b"/>
            <Setter Property="BorderBrush" Value="#141d2b"/>
        </Style>

        <!-- Success Button (Save changes, commits) -->
        <Style Selector="Button.btn-success">
            <Setter Property="Background" Value="#064e3b"/>
            <Setter Property="Foreground" Value="#ecfdf5"/>
            <Setter Property="BorderBrush" Value="#059669"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.btn-success:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#047857"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#10b981"/>
        </Style>
        <Style Selector="Button.btn-success:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#064e3b"/>
            <Setter Property="Foreground" Value="#a7f3d0"/>
            <Setter Property="BorderBrush" Value="#047857"/>
        </Style>

        <!-- Danger / Destructive Button (Delete, Disconnect, Discard) -->
        <Style Selector="Button.btn-danger">
            <Setter Property="Background" Value="#2d1519"/>
            <Setter Property="Foreground" Value="#f87171"/>
            <Setter Property="BorderBrush" Value="#4c1d24"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3d1a20"/>
            <Setter Property="Foreground" Value="#fca5a5"/>
            <Setter Property="BorderBrush" Value="#7f1d1d"/>
        </Style>
        <Style Selector="Button.btn-danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#200d11"/>
            <Setter Property="Foreground" Value="#ef4444"/>
            <Setter Property="BorderBrush" Value="#3d1a20"/>
        </Style>

        <!-- Small Icon Button (Zoom, Refresh, Compact utility) -->
        <Style Selector="Button.btn-icon">
            <Setter Property="Background" Value="#141d2b"/>
            <Setter Property="Foreground" Value="#8b9cb3"/>
            <Setter Property="BorderBrush" Value="#1e2d42"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style Selector="Button.btn-icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1e2b40"/>
            <Setter Property="Foreground" Value="#f0f6fc"/>
            <Setter Property="BorderBrush" Value="#2e4363"/>
        </Style>
        <Style Selector="Button.btn-icon:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#0e1520"/>
            <Setter Property="Foreground" Value="#8b9cb3"/>
            <Setter Property="BorderBrush" Value="#141d2b"/>
        </Style>
        <!-- Titlebar Control Buttons (Windows/Linux) -->
        <Style Selector="Button.titlebar-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8b9cb3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.titlebar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1e2d42"/>
            <Setter Property="Foreground" Value="#f0f6fc"/>
        </Style>
        <Style Selector="Button.titlebar-close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#dc2626"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Runix.Desktop/Locale/Strings.pt-BR.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom RUNIX Palette -->
            <SolidColorBrush x:Key="RunixDarkBlue">#0064a5</SolidColorBrush>
            <SolidColorBrush x:Key="RunixBaseBlue">#336791</SolidColorBrush>
            <SolidColorBrush x:Key="RunixLightBlue">#008bb9</SolidColorBrush>
            <SolidColorBrush x:Key="RunixBgDark">#090d14</SolidColorBrush>
            <SolidColorBrush x:Key="RunixBgSidebar">#0e141f</SolidColorBrush>
            <SolidColorBrush x:Key="RunixBgCard">#141d2b</SolidColorBrush>
            <SolidColorBrush x:Key="RunixBgInput">#0a0f17</SolidColorBrush>
            <SolidColorBrush x:Key="RunixBorder">#1e2d42</SolidColorBrush>
            <SolidColorBrush x:Key="RunixTextPrimary">#f0f6fc</SolidColorBrush>
            <SolidColorBrush x:Key="RunixTextSecondary">#8b9cb3</SolidColorBrush>
            <SolidColorBrush x:Key="RunixAccentGlow">#1a3a5c</SolidColorBrush>

            <!-- Official Database Engine Vector Geometries -->
            <StreamGeometry x:Key="IconSqlite">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M10,6V8H14V6H10M8,9V11H16V9H8M7,12V14H17V12H7M8,15V17H16V15H8M10,18V20H14V18H10Z</StreamGeometry>
            <StreamGeometry x:Key="IconPostgres">M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
            <StreamGeometry x:Key="IconMySql">M19.5,4C18.5,4 17.8,4.5 17.3,5.2C16.5,4.3 15.3,3.8 14,4C11.6,4.4 10.4,7 10.9,9.4C11.1,10.4 11.7,11.2 12.5,11.8C10.9,12.5 8.7,13.8 7,16C5.5,18 4.5,20 4,21C4.8,20.8 7.2,20 9.5,18.5C10.8,17.7 12.2,16.6 13.5,15.5C14.8,16.5 16.4,17.2 18.2,17.5C19.8,17.7 20.8,17 21.2,16.2C21.6,15.4 21.4,14.2 20.4,13.2C19.6,12.4 18.4,11.9 17.2,11.8C17.8,10.7 18.1,9.3 17.8,8C17.6,7.2 17.1,6.5 16.5,6C17.2,5.5 18.2,5.2 19.5,5.5C20.2,5.7 20.8,6.2 21.2,6.8L22,6C21.5,5 20.6,4.2 19.5,4Z</StreamGeometry>
            <StreamGeometry x:Key="IconMariaDb">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12C20,13.84 19.38,15.53 18.33,16.89C17.47,15.47 16.03,14.4 14.5,13.88C15.42,13.27 16,12.21 16,11A4,4 0 0,0 12,7A4,4 0 0,0 8,11C8,12.21 8.58,13.27 9.5,13.88C7.97,14.4 6.53,15.47 5.67,16.89C4.62,15.53 4,13.84 4,12A8,8 0 0,1 12,4M12,9A2,2 0 0,1 14,11A2,2 0 0,1 12,13A2,2 0 0,1 10,11A2,2 0 0,1 12,9Z</StreamGeometry>
            <StreamGeometry x:Key="IconSqlServer">M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z</StreamGeometry>

            <!-- Engine Accent Colors -->
            <SolidColorBrush x:Key="BrandSqliteBg">#003b57</SolidColorBrush>
            <SolidColorBrush x:Key="BrandSqliteAccent">#38bdf8</SolidColorBrush>
            <SolidColorBrush x:Key="BrandPostgresBg">#1e3a5f</SolidColorBrush>
            <SolidColorBrush x:Key="BrandPostgresAccent">#60a5fa</SolidColorBrush>
            <SolidColorBrush x:Key="BrandMySqlBg">#00485c</SolidColorBrush>
            <SolidColorBrush x:Key="BrandMySqlAccent">#f29111</SolidColorBrush>
            <SolidColorBrush x:Key="BrandMariaDbBg">#003545</SolidColorBrush>
            <SolidColorBrush x:Key="BrandMariaDbAccent">#c084fc</SolidColorBrush>
            <SolidColorBrush x:Key="BrandSqlServerBg">#450a0a</SolidColorBrush>
            <SolidColorBrush x:Key="BrandSqlServerAccent">#f87171</SolidColorBrush>
        </ResourceDictionary>
    </Application.Resources>
</Application>

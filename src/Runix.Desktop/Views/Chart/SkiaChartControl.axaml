<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
             x:Class="Runix.Desktop.Views.Chart.SkiaChartControl"
             Background="#090d14">

    <Grid RowDefinitions="Auto,*">
        <!-- TOP CONFIGURATION TOOLBAR -->
        <Border Grid.Row="0" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
                <!-- Chart Type Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Tipo:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                    <ComboBox Name="CboChartType" Width="150" Padding="8,4" FontSize="11"
                              Background="#141d2b" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="4"/>
                </StackPanel>

                <!-- X Axis Column -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Eixo X:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                    <ComboBox Name="CboXColumn" Width="140" Padding="8,4" FontSize="11"
                              Background="#141d2b" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="4"/>
                </StackPanel>

                <!-- Y Axis Column -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Eixo Y:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                    <ComboBox Name="CboYColumn" Width="140" Padding="8,4" FontSize="11"
                              Background="#141d2b" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="4"/>
                </StackPanel>

                <!-- Aggregation Selector -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Agregação:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                    <ComboBox Name="CboAggregation" Width="130" Padding="8,4" FontSize="11"
                              Background="#141d2b" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="4"/>
                </StackPanel>

                <!-- Top N Selector -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Limite:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                    <ComboBox Name="CboTopN" Width="100" Padding="8,4" FontSize="11"
                              Background="#141d2b" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="4"/>
                </StackPanel>

                <!-- Export & Action Buttons -->
                <Button Name="BtnExportPng" Grid.Column="6" Content="💾 PNG" Classes="btn-secondary" Padding="10,5" FontSize="11" Margin="0,0,6,0"
                        ToolTip.Tip="Exportar gráfico em imagem PNG de alta resolução (2x Retina)"/>
                <Button Name="BtnExportSvg" Grid.Column="7" Content="💾 SVG" Classes="btn-outline" Padding="10,5" FontSize="11" Margin="0,0,6,0"
                        ToolTip.Tip="Exportar gráfico vetorial em formato SVG"/>
                <Button Name="BtnCopyImage" Grid.Column="8" Content="📋 Copiar" Classes="btn-outline" Padding="10,5" FontSize="11"
                        ToolTip.Tip="Copiar imagem do gráfico para a Área de Transferência"/>
            </Grid>
        </Border>

        <!-- CANVAS HOST & INTERACTIVE OVERLAY -->
        <Grid Grid.Row="1" Background="#090d14" ClipToBounds="True">
            <!-- Rendered Chart Image -->
            <Image Name="ImgChartCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Uniform"/>

            <!-- Interactive Tooltip Overlay -->
            <Canvas Name="CanvasOverlay" IsHitTestVisible="False">
                <Border Name="PanelTooltip" Background="#0e141f" BorderBrush="#008bb9" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" BoxShadow="0 4 16 #80000000" IsVisible="False">
                    <StackPanel Spacing="3">
                        <TextBlock Name="TxtTooltipCategory" FontSize="11" FontWeight="Bold" Foreground="#f0f6fc"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Name="TxtTooltipValue" FontSize="13" FontWeight="SemiBold" Foreground="#38bdf8"/>
                            <TextBlock Name="TxtTooltipPercentage" FontSize="10" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Canvas>

            <!-- Empty State Placeholder -->
            <Border Name="PanelEmptyState" Background="#090d14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="📈" FontSize="36" HorizontalAlignment="Center"/>
                    <TextBlock Text="Nenhum dado numérico disponível para gerar o gráfico." FontSize="14" FontWeight="SemiBold" Foreground="#f0f6fc" HorizontalAlignment="Center"/>
                    <TextBlock Text="Execute uma consulta com colunas de texto e números para visualizar os dados graficamente."
                               FontSize="11" Foreground="#8b9cb3" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
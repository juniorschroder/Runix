<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Runix.Desktop.Views"
             xmlns:dialogs="clr-namespace:Runix.Desktop.Views.Dialogs"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Runix.Desktop.Views.ErdTabControl"
             Background="#090d14">

    <Grid RowDefinitions="Auto,*">
        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="12,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Name="BtnNewTable" Content="{DynamicResource Erd.NewTable}" 
                        Classes="btn-primary" Padding="14,6" Margin="0,2,8,2"
                        AutomationProperties.Name="Criar Nova Tabela no Diagrama ER"/>

                <Button Name="BtnAutoLayout" Content="{DynamicResource Erd.AutoLayout}" 
                        Classes="btn-secondary" Padding="12,6" Margin="0,2,8,2"
                        ToolTip.Tip="{DynamicResource Erd.AutoLayout.Tooltip}"
                        AutomationProperties.Name="Organizar Layout do Diagrama Automaticamente"/>

                <Button Name="BtnNewSubjectArea" Content="{DynamicResource Erd.SubjectAreas.NewArea}"
                        Classes="btn-outline" Padding="12,6" Margin="0,2,8,2"
                        ToolTip.Tip="Criar nova Área de Domínio (Subject Area) para agrupar tabelas"
                        AutomationProperties.Name="Criar Nova Área de Domínio"/>

                <Button Name="BtnExportDiagram" Content="{DynamicResource Erd.Export.Button}" 
                        Classes="btn-outline" Padding="12,6" Margin="0,2,8,2"
                        ToolTip.Tip="{DynamicResource Erd.Export.Tooltip}"
                        AutomationProperties.Name="Exportar Diagrama ER"/>

                <Button Name="BtnSearch" Content="{DynamicResource Erd.Search.Button}"
                        Classes="btn-outline" Padding="10,6" Margin="0,2,12,2"
                        ToolTip.Tip="{DynamicResource Erd.Search.Tooltip}"
                        AutomationProperties.Name="Buscar tabelas ou colunas no diagrama"/>

                <!-- Zoom Controls -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,0,2">
                    <Button Name="BtnZoomOut" Content="{DynamicResource Erd.ZoomOut}" Classes="btn-icon"
                            AutomationProperties.Name="Diminuir Zoom do Diagrama"/>
                    <TextBlock Name="TxtZoomPercent" Text="100%" VerticalAlignment="Center" FontSize="11" Foreground="#f0f6fc" Width="40" TextAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button Name="BtnZoomIn" Content="{DynamicResource Erd.ZoomIn}" Classes="btn-icon"
                            AutomationProperties.Name="Aumentar Zoom do Diagrama"/>
                    <Button Name="BtnResetZoom" Content="{DynamicResource Erd.ResetZoom}" Classes="btn-accent-subtle" Padding="8,4" FontSize="11"
                            AutomationProperties.Name="Redefinir Zoom para 100%"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- MAIN AREA: Canvas + Overlay Modals -->
        <Grid Grid.Row="1">
            <!-- Interactivity Canvas -->
            <views:ErdCanvasControl Name="CanvasErd"
                                    AutomationProperties.Name="{DynamicResource A11y.ErdCanvas}"
                                    AutomationProperties.HelpText="Diagrama visual interativo de entidades e relacionamentos entre tabelas"/>

            <!-- FAST SEARCH OVERLAY (Ctrl/Cmd+F) -->
            <views:ErdSearchOverlayControl Name="OverlaySearch"
                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,12,16,0" IsVisible="False" ZIndex="95"/>

            <!-- Loading Indicator -->
            <ProgressBar Name="ProgressLoading" IsIndeterminate="True" Height="4" Width="220" 
                         Foreground="#008bb9" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>

            <!-- Error / Retry Banner -->
            <Border Name="BannerError" Background="#2e1414" BorderBrush="#f87171" BorderThickness="1"
                    CornerRadius="6" Padding="16,12" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="False" ZIndex="90">
                <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Name="TxtErrorMessage" Text="Erro ao carregar o diagrama ER." Foreground="#fca5a5" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                    <Button Name="BtnRetryLoad" Content="Tentar Novamente" Classes="btn-secondary" HorizontalAlignment="Center" Padding="12,6"/>
                </StackPanel>
            </Border>

            <!-- TABLE EDITOR MODAL OVERLAY -->
            <Border Name="OverlayTableEditor" Background="#d0090d14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    IsVisible="False" ZIndex="100">
                <dialogs:TableEditorDialog Name="DialogTableEditor" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- FOREIGN KEY MODAL OVERLAY -->
            <Border Name="OverlayForeignKey" Background="#d0090d14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    IsVisible="False" ZIndex="100">
                <dialogs:ForeignKeyDialog Name="DialogForeignKey" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- MIGRATION PREVIEW MODAL OVERLAY -->
            <Border Name="OverlayMigrationPreview" Background="#d0090d14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    IsVisible="False" ZIndex="110">
                <dialogs:MigrationPreviewDialog Name="DialogMigrationPreview" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- CREATE SUBJECT AREA MODAL OVERLAY -->
            <Border Name="OverlaySubjectArea" Background="#d0090d14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    IsVisible="False" ZIndex="105">
                <dialogs:CreateSubjectAreaDialog Name="DialogCreateSubjectArea" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- EXPORT MODAL OVERLAY -->
            <Border Name="OverlayExport" Background="#d0090d14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    IsVisible="False" ZIndex="115">
                <dialogs:ErdExportDialog Name="DialogExport" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>

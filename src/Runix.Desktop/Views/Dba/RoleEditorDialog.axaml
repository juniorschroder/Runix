<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             x:Class="Runix.Desktop.Views.Dba.RoleEditorDialog">

    <Border Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="8"
            Padding="24" Width="480" BoxShadow="0 8 32 #50000000">
        <StackPanel Spacing="16">
            <!-- HEADER -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🛡" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtDialogTitle" Text="Criar Nova Role / Usuário" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Name="BtnCloseTop" Grid.Column="1" Content="✕" Classes="btn-outline" Padding="8,4" FontSize="11"
                        AutomationProperties.Name="{DynamicResource A11y.CloseModal}"/>
            </Grid>

            <!-- ROLE NAME -->
            <StackPanel Spacing="6">
                <TextBlock Text="Nome da Role / Usuário" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                <TextBox Name="TxtRoleName" Watermark="ex: app_developer" 
                         Background="#141d2b" Foreground="#f0f6fc" BorderBrush="#1e2d42" Padding="10,8" CornerRadius="4"
                         AutomationProperties.Name="Nome da Role ou Usuário"/>
            </StackPanel>

            <!-- PASSWORD WITH TOGGLE SHOW/HIDE -->
            <StackPanel Spacing="6">
                <TextBlock Text="Senha (deixe em branco para manter a atual)" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="TxtPassword" PasswordChar="●" Watermark="Senha segura..." 
                             Background="#141d2b" Foreground="#f0f6fc" BorderBrush="#1e2d42" Padding="10,8" CornerRadius="4,0,0,4"
                             AutomationProperties.Name="Senha do Usuário"/>
                    <Button Name="BtnTogglePassword" Grid.Column="1" Content="👁" Classes="btn-secondary" 
                            Padding="10,8" CornerRadius="0,4,4,0"
                            AutomationProperties.Name="Alternar visualização da senha"/>
                </Grid>
            </StackPanel>

            <!-- SYSTEM PRIVILEGES & ATTRIBUTES -->
            <StackPanel Spacing="8">
                <TextBlock Text="Privilégios de Sistema" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="12">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
                        <CheckBox Name="ChkCanLogin" Grid.Row="0" Grid.Column="0" Content="Permitir Login (LOGIN)" IsChecked="True" Foreground="#f0f6fc" Margin="0,0,0,8"/>
                        <CheckBox Name="ChkSuperuser" Grid.Row="0" Grid.Column="1" Content="Superusuário (SUPERUSER)" Foreground="#f0f6fc" Margin="0,0,0,8"/>
                        
                        <CheckBox Name="ChkCreateDb" Grid.Row="1" Grid.Column="0" Content="Criar Banco (CREATEDB)" Foreground="#f0f6fc" Margin="0,0,0,8"/>
                        <CheckBox Name="ChkCreateRole" Grid.Row="1" Grid.Column="1" Content="Criar Roles (CREATEROLE)" Foreground="#f0f6fc" Margin="0,0,0,8"/>
                        
                        <CheckBox Name="ChkInherit" Grid.Row="2" Grid.Column="0" Content="Herança (INHERIT)" IsChecked="True" Foreground="#f0f6fc"/>
                        <CheckBox Name="ChkReplication" Grid.Row="2" Grid.Column="1" Content="Replicação (REPLICATION)" Foreground="#f0f6fc"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- EXPIRATION -->
            <StackPanel Spacing="8">
                <TextBlock Text="Validade da Conta" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="8">
                        <CheckBox Name="ChkNeverExpires" Content="Nunca expira (VALID UNTIL 'infinity')" IsChecked="True" Foreground="#f0f6fc"/>
                        <StackPanel Name="PanelDatePicker" Orientation="Horizontal" Spacing="8" IsVisible="False">
                            <TextBlock Text="Expira em:" VerticalAlignment="Center" FontSize="11" Foreground="#8b9cb3"/>
                            <DatePicker Name="DpValidUntil"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ERROR MESSAGE -->
            <TextBlock Name="TxtError" Text="" Foreground="#f87171" FontSize="12" TextWrapping="Wrap" IsVisible="False"
                       AutomationProperties.LiveSetting="Assertive"/>

            <!-- ACTIONS -->
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                <Button Name="BtnCancel" Grid.Column="1" Content="Cancelar" Classes="btn-outline" Padding="16,8" Margin="0,0,8,0"
                        AutomationProperties.Name="{DynamicResource Common.Cancel}"/>
                <Button Name="BtnSave" Grid.Column="2" Content="Salvar Role" Classes="btn-primary" Padding="18,8"
                        AutomationProperties.Name="Salvar Role"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

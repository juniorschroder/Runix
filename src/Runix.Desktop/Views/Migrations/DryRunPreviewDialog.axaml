<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="600"
             x:Class="Runix.Desktop.Views.Migrations.DryRunPreviewDialog">

    <Border Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="8"
            Padding="20" Width="760" MaxHeight="620" BoxShadow="0 8 32 #50000000">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- HEADER -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🔍" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Migrations.DryRunTitle}" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Name="BtnCloseTop" Grid.Column="1" Content="✕" Classes="btn-outline" Padding="8,4" FontSize="11"/>
            </Grid>

            <!-- SUMMARY BANNER -->
            <Border Grid.Row="1" Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtPendingSummary" Text="0 migrações pendentes em fila de execução"
                                   Foreground="#fbbf24" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Name="TxtExecutionOrderHint" Grid.Column="1" Text="Ordem Semântica Garantida"
                               Foreground="#64748b" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- COMBINED SQL VIEWER -->
            <Border Grid.Row="2" Background="#090d14" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBox Name="TxtCombinedSql" IsReadOnly="True" FontFamily="Consolas, Menlo, Monaco, monospace"
                             Background="Transparent" BorderThickness="0" Foreground="#38bdf8" FontSize="12" TextWrapping="NoWrap"/>
                </ScrollViewer>
            </Border>

            <!-- FOOTER ACTIONS -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0">
                <TextBlock Name="TxtCopyStatus" Grid.Column="0" Text="" FontSize="11" Foreground="#34d399" VerticalAlignment="Center"/>

                <Button Name="BtnCopySql" Grid.Column="2" Content="{DynamicResource Common.CopySql}" Classes="btn-secondary"
                        Padding="14,7" Margin="0,0,8,0" FontSize="11"/>
                <Button Name="BtnClose" Grid.Column="3" Content="{DynamicResource Common.Close}" Classes="btn-outline"
                        Padding="16,7" FontSize="11"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>

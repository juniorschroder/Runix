<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Runix.Core.Models;assembly=Runix.Core"
             xmlns:views="clr-namespace:Runix.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="650"
             x:Class="Runix.Desktop.Views.GlobalSearchTabControl"
             Background="#090d14">

    <Grid RowDefinitions="Auto,*,34">
        <!-- Top Search Toolbar -->
        <Border Grid.Row="0" Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="🔎" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="Busca Global no Banco" FontWeight="Bold" FontSize="13" Foreground="#38bdf8" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBox Name="TxtSearchTerm" Grid.Column="1"
                         Watermark="Digite qualquer texto, ID, e-mail ou valor para buscar em todas as tabelas..."
                         Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5"
                         Padding="10,6" FontSize="12" Margin="0,0,10,0"/>

                <CheckBox Name="ChkCaseSensitive" Grid.Column="2" Content="Diferenciar Maiúsculas (Aa)"
                          Foreground="#cbd5e1" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Limite/Tabela:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                    <ComboBox Name="CmbMaxRows" SelectedIndex="1" Width="76" FontSize="11" Background="#090d14" Foreground="#f0f6fc">
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="25"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="100"/>
                    </ComboBox>
                </StackPanel>

                <Button Name="BtnRunSearch" Grid.Column="4" Content="🔎 Buscar em Tudo"
                        Classes="btn-primary" Padding="14,6" FontSize="11.5" Margin="0,0,6,0"/>

                <Button Name="BtnCancelSearch" Grid.Column="5" Content="⏹ Cancelar"
                        Classes="btn-danger" Padding="10,6" FontSize="11" IsVisible="False"/>
            </Grid>
        </Border>

        <!-- Main Split Body: Left = Matched Tables, Right = Sample Rows + Inspector Drawer -->
        <Grid Grid.Row="1" ColumnDefinitions="290,4,*">
            <!-- Left: Matched Tables List -->
            <Border Grid.Column="0" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#101826" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="12,8">
                        <TextBlock Name="TxtTablesHeader" Text="Tabelas com Ocorrências (0)" FontSize="11" FontWeight="Bold" Foreground="#8b9cb3"/>
                    </Border>

                    <ListBox Name="ListMatchedTables" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:GlobalSearchTableMatch">
                                <Border Padding="10,8" CornerRadius="6" Margin="0,2" Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" FontSize="12" FontWeight="Bold"
                                                       Foreground="#f0f6fc" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="1" Background="#123524" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding MatchedRowCount, StringFormat='{}{0} linhas'}"
                                                           FontSize="10" FontWeight="Bold" Foreground="#34d399"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding MatchedColumnsSummary}" FontSize="10"
                                                   Foreground="#38bdf8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Background="#1e2d42" ResizeDirection="Columns" HorizontalAlignment="Stretch"/>

            <!-- Right: Sample DataGrid + Open Filtered Table Action + Inspector Drawer -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Name="TxtActiveMatchTitle" Grid.Column="0"
                                   Text="Selecione uma tabela à esquerda para inspecionar os registros encontrados"
                                   FontSize="11.5" FontWeight="SemiBold" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                        <Button Name="BtnOpenInTableTab" Grid.Column="1" Content="📊 Abrir Tabela Filtrada"
                                Classes="btn-secondary" Padding="10,4" FontSize="11" Margin="0,0,6,0" IsEnabled="False"/>
                        <Button Name="BtnToggleInspector" Grid.Column="2" Content="🔬 Inspetor de Linha"
                                Classes="btn-outline" Padding="10,4" FontSize="11"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <DataGrid Name="GridSampleRows" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="All" HeadersVisibility="Column"
                              BorderThickness="0" Background="#090d14" Foreground="#f0f6fc"
                              RowBackground="#0c111a"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>

                    <views:RecordInspectorDrawer Name="DrawerInspector" Grid.Column="1" Width="330" IsVisible="False"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,1,0,0" Padding="14,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="TxtStatus" Grid.Column="0" Text="Pronto para buscar em todas as tabelas."
                           FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                <ProgressBar Name="ProgressScan" Grid.Column="1" Width="160" Height="4"
                             IsIndeterminate="True" IsVisible="False" Foreground="#008bb9" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

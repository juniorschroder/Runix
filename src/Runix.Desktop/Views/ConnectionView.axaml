<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Runix.Core.Models;assembly=Runix.Core"
             xmlns:uiModels="clr-namespace:Runix.Desktop.Models;assembly=Runix.Desktop"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Runix.Desktop.Views.ConnectionView"
             Background="#090d14">

    <UserControl.Styles>
        <Style Selector="TreeViewItem" x:DataType="models:ConnectionCategoryGroup">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#141d2b"/>
        </Style>
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#1a3a5c"/>
        </Style>
        <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#1e446d"/>
        </Style>
        <Style Selector="Border.category-group-header">
            <Setter Property="Background" Value="#0b111a"/>
            <Setter Property="BorderBrush" Value="#152030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.category-group-header.dragover">
            <Setter Property="Background" Value="#0d2847"/>
            <Setter Property="BorderBrush" Value="#38bdf8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.connection-item">
            <Setter Property="Background" Value="#141d2b"/>
            <Setter Property="BorderBrush" Value="#1a2639"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.connection-item.dragging">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="ComboBox#CmbDatabaseEngine">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox#CmbDatabaseEngine ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="360,4,*">
        <!-- LEFT PANEL: Saved Connections & Categories -->
        <Border Grid.Column="0" MinWidth="260" MaxWidth="600" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="16">
                <!-- Branding Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="38" Height="38" CornerRadius="8" Background="#0064a5">
                            <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource App.Title}" FontSize="22" FontWeight="Bold" Foreground="#008bb9" LetterSpacing="1.5"/>
                            <TextBlock Text="{DynamicResource App.Subtitle}" FontSize="11" Foreground="#8b9cb3" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Saved Connections Header -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Connection.SavedConnections}" FontSize="11" FontWeight="Bold" Foreground="#336791" VerticalAlignment="Center"/>
                    <Button Name="BtnNewCategory" Grid.Column="1" Content="{DynamicResource Connection.NewCategory}"
                            Classes="btn-secondary" FontSize="10.5" Padding="9,4" Margin="0,0,6,0"
                            AutomationProperties.Name="{DynamicResource A11y.NewCategory}"
                            ToolTip.Tip="Criar uma nova categoria para agrupar conexões"/>
                    <Button Name="BtnNewConnection" Grid.Column="2" Content="{DynamicResource Connection.New}" 
                            Classes="btn-accent-subtle" FontSize="10.5" Padding="10,4"
                            AutomationProperties.Name="{DynamicResource A11y.NewConnection}"/>
                </Grid>

                <!-- Inline New Category Bar (Toggled by + Categoria) -->
                <Border Name="PanelNewCategoryBar" Grid.Row="2" Background="#090d14" BorderBrush="#008bb9" BorderThickness="1"
                        CornerRadius="6" Padding="8,6" Margin="0,0,0,8" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Name="TxtNewCategoryInput" Grid.Column="0" Watermark="{DynamicResource Connection.NewCategoryWatermark}"
                                 Background="#0e141f" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="4"
                                 Padding="8,4" FontSize="11.5" Margin="0,0,6,0"
                                 AutomationProperties.Name="{DynamicResource A11y.NewCategory}"/>
                        <Button Name="BtnConfirmNewCategory" Grid.Column="1" Content="{DynamicResource Connection.AddCategoryBtn}"
                                Classes="btn-primary" FontSize="11" Padding="10,4" Margin="0,0,4,0"
                                AutomationProperties.Name="{DynamicResource Connection.AddCategoryBtn}"/>
                        <Button Name="BtnCancelNewCategory" Grid.Column="2" Content="✕"
                                Classes="btn-icon" FontSize="10" Padding="6,4"
                                AutomationProperties.Name="{DynamicResource Common.Cancel}"/>
                    </Grid>
                </Border>

                <!-- Inline Rename Category Bar -->
                <Border Name="PanelRenameCategoryBar" Grid.Row="2" Background="#090d14" BorderBrush="#38bdf8" BorderThickness="1"
                        CornerRadius="6" Padding="8,6" Margin="0,0,0,8" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Name="TxtRenameCategoryInput" Grid.Column="0" Watermark="{DynamicResource Connection.RenameCategoryWatermark}"
                                 Background="#0e141f" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="4"
                                 Padding="8,4" FontSize="11.5" Margin="0,0,6,0"
                                 AutomationProperties.Name="{DynamicResource Connection.RenameCategoryWatermark}"/>
                        <Button Name="BtnConfirmRenameCategory" Grid.Column="1" Content="Salvar"
                                Classes="btn-primary" FontSize="11" Padding="10,4" Margin="0,0,4,0"/>
                        <Button Name="BtnCancelRenameCategory" Grid.Column="2" Content="✕"
                                Classes="btn-icon" FontSize="10" Padding="6,4"
                                AutomationProperties.Name="{DynamicResource Common.Cancel}"/>
                    </Grid>
                </Border>

                <!-- Filter Search Box -->
                <TextBox Name="TxtFilterConnections" Grid.Row="3" Watermark="{DynamicResource Connection.FilterPlaceholder}"
                         Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="6"
                         Padding="9,6" FontSize="11.5" Margin="0,0,0,6"
                         AutomationProperties.Name="{DynamicResource A11y.SearchConnections}"/>

                <!-- Helpful Tip Banner for Instant Connection -->
                <Border Grid.Row="4" Background="#091424" BorderBrush="#152b44" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="💡" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Connection.SavedTip}"
                                   FontSize="10" Foreground="#64748b" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Grouped Connections TreeView -->
                <TreeView Name="TreeSavedConnections" Grid.Row="5" Background="Transparent" BorderThickness="0"
                          DragDrop.AllowDrop="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="{DynamicResource A11y.SavedConnectionsList}">
                    <TreeView.DataTemplates>
                        <!-- Category Group Header Node -->
                        <TreeDataTemplate DataType="models:ConnectionCategoryGroup" ItemsSource="{Binding Connections}">
                            <Border DragDrop.AllowDrop="True"
                                    Classes="category-group-header"
                                    Classes.dragover="{Binding IsDragOver}"
                                    Padding="8,5" Margin="0,2,14,1" CornerRadius="6">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="➕ Nova Conexão nesta Categoria" Click="OnCategoryMenuAddConnectionClick"/>
                                        <MenuItem Header="✏️ Renomear Categoria" Click="OnCategoryMenuRenameClick" IsVisible="{Binding !IsUncategorized}"/>
                                        <Separator IsVisible="{Binding !IsUncategorized}"/>
                                        <MenuItem Header="🗑️ Excluir Categoria (Mover para Geral)" Click="OnCategoryMenuDeleteClick" IsVisible="{Binding !IsUncategorized}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="11.5"
                                               Foreground="#38bdf8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    
                                    <!-- Efeito visual de destaque ao arrastar: badge 'Soltar aqui' -->
                                    <Border Grid.Column="2" IsVisible="{Binding IsDragOver}"
                                            Background="#0284c7" BorderBrush="#38bdf8" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="📥" FontSize="9.5" VerticalAlignment="Center"/>
                                            <TextBlock Text="Soltar aqui" FontSize="9.5" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Contador de conexões (visível quando não em dragover) -->
                                    <Border Grid.Column="3" Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1"
                                            CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                            IsVisible="{Binding !IsDragOver}">
                                        <TextBlock Text="{Binding HeaderBadge}" FontSize="9.5" FontWeight="Bold" Foreground="#8b9cb3"/>
                                    </Border>
                                    <Button Grid.Column="4" Name="BtnAddInCategory" Content="+" Classes="btn-icon"
                                            Padding="5,0" Margin="6,0,0,0" FontSize="11" FontWeight="Bold"
                                            Background="Transparent" BorderThickness="0" Foreground="#38bdf8"
                                            Tag="{Binding CategoryName}"
                                            Click="OnAddConnectionInCategoryClick"
                                            ToolTip.Tip="Nova conexão nesta categoria"/>
                                    <Button Grid.Column="5" Name="BtnCategoryOptions" Content="⋮" Classes="btn-icon"
                                            Padding="4,0" Margin="2,0,0,0" FontSize="12"
                                            Background="Transparent" BorderThickness="0" Foreground="#8b9cb3"
                                            Tag="{Binding}"
                                            Click="OnCategoryOptionsClick"
                                            ToolTip.Tip="Opções da categoria (Renomear, Excluir)"/>
                                </Grid>
                            </Border>
                        </TreeDataTemplate>

                        <!-- Individual Connection Leaf Node -->
                        <DataTemplate DataType="models:ConnectionConfig">
                            <Border Classes="connection-item"
                                    Classes.dragging="{Binding IsBeingDragged}"
                                    DragDrop.AllowDrop="True"
                                    Padding="8,6" Margin="0,1,14,1" CornerRadius="6"
                                    PointerPressed="OnConnectionPointerPressed"
                                    PointerMoved="OnConnectionPointerMoved">
                                <Border.ContextMenu>
                                    <ContextMenu Opened="OnConnectionContextMenuOpened">
                                        <MenuItem Header="⚡ Conectar Agora" Click="OnContextMenuConnectClick"/>
                                        <MenuItem Header="✏️ Editar Configurações" Click="OnContextMenuEditClick"/>
                                        <MenuItem Name="MenuMoveToCategory" Header="{DynamicResource Connection.MoveToCategory}"/>
                                        <Separator/>
                                        <MenuItem Header="🧪 Testar Conexão" Click="OnContextMenuTestClick"/>
                                        <MenuItem Header="📋 Duplicar Conexão" Click="OnContextMenuDuplicateClick"/>
                                        <MenuItem Header="🗑️ Excluir" Click="OnContextMenuDeleteClick"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,9,0"
                                            Background="#1a3a5c" BorderBrush="#1e2d42" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EngineIcon}" FontSize="14" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="#f0f6fc" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplaySubtitle}" FontSize="10.5" Foreground="#8b9cb3" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Border Background="#064e3b" BorderBrush="#10b981" BorderThickness="1" CornerRadius="3" Padding="4,1"
                                                IsVisible="{Binding UseSshTunnel}" ToolTip.Tip="Conexão protegida via Túnel SSH (Bastion Host)">
                                            <TextBlock Text="🔐 SSH" FontSize="9" FontWeight="Bold" Foreground="#6ee7b7"/>
                                        </Border>
                                        <Border Background="#450a0a" BorderBrush="#ef4444" BorderThickness="1" CornerRadius="3" Padding="4,1"
                                                IsVisible="{Binding IsProductionEnvironment}" ToolTip.Tip="Ambiente de Produção (Alerta &amp; Proteção)">
                                            <TextBlock Text="🚨 PROD" FontSize="9" FontWeight="Bold" Foreground="#fca5a5"/>
                                        </Border>
                                        <Border Background="#1e1b4b" BorderBrush="#6366f1" BorderThickness="1" CornerRadius="3" Padding="4,1"
                                                IsVisible="{Binding IsReadOnly}" ToolTip.Tip="Conexão Somente-Leitura (Read-Only Lock)">
                                            <TextBlock Text="🔒 RO" FontSize="9" FontWeight="Bold" Foreground="#c7d2fe"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- Direct 1-Click Connect Button -->
                                    <Button Grid.Column="3" Name="BtnQuickConnectItem" Classes="btn-accent-subtle"
                                            Content="⚡ Conectar" FontSize="10.5" Padding="8,4" Margin="8,0,0,0"
                                            VerticalAlignment="Center" FontWeight="SemiBold"
                                            ToolTip.Tip="Conectar imediatamente a esta base de dados"
                                            Click="OnDirectConnectItemClick"
                                            Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </TreeView.DataTemplates>
                </TreeView>

                <!-- Export / Import .RCF Bundle Footer -->
                <Border Grid.Row="6" BorderBrush="#1e2d42" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="COMPARTILHAR PACOTE CRIPTOGRAFADO (.RCF)" FontSize="9" FontWeight="Bold" Foreground="#64748b" LetterSpacing="0.5"/>
                        <Grid ColumnDefinitions="*,*">
                            <Button Name="BtnImportRcf" Grid.Column="0" Content="📥 Importar .rcf"
                                    Classes="btn-secondary" FontSize="11" Padding="10,7" Margin="0,0,4,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    AutomationProperties.Name="Importar pacote criptografado RCF"
                                    ToolTip.Tip="Importar conexões, queries salvas e snippets de um arquivo .rcf protegido por senha"/>
                            <Button Name="BtnExportRcf" Grid.Column="1" Content="📤 Exportar .rcf"
                                    Classes="btn-secondary" FontSize="11" Padding="10,7" Margin="4,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    AutomationProperties.Name="Exportar pacote criptografado RCF"
                                    ToolTip.Tip="Exportar conexões, queries salvas e snippets selecionados para um arquivo .rcf criptografado com senha"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- SPLITTER DIVIDER -->
        <GridSplitter Grid.Column="1" Width="4" Background="#1e2d42" ResizeDirection="Columns"/>

        <!-- RIGHT PANEL: Connection Form -->
        <ScrollViewer Grid.Column="2" Background="#090d14" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch" Margin="40,30,40,40" Spacing="22">
                <!-- Title & Language Selector Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="6" Grid.Column="0">
                        <TextBlock Name="TxtFormTitle" Text="{DynamicResource Connection.Title}" FontSize="24" FontWeight="Bold" Foreground="#f0f6fc"/>
                        <TextBlock Text="{DynamicResource Connection.Subtitle}" FontSize="13" Foreground="#8b9cb3"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <!-- About Dialog Trigger -->
                        <Button Name="BtnAbout" Classes="btn-secondary" Padding="12,6" FontWeight="Bold"
                                ToolTip.Tip="{DynamicResource About.Title}"
                                AutomationProperties.Name="{DynamicResource A11y.AboutApp}">
                            <TextBlock Text="{DynamicResource About.Button}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Language Switcher Toggle -->
                        <Button Name="BtnLanguageToggle" Classes="btn-secondary" Padding="12,6" FontWeight="Bold"
                                AutomationProperties.Name="{DynamicResource A11y.LanguageSwitch}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🌐" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Name="TxtLanguageLabel" Text="PT | EN" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- QUICK CONNECT HERO BANNER (Direct & Highly Visible Action without Scrolling) -->
                <Border Name="CardQuickConnect" Background="#0b1726" BorderBrush="#008bb9" BorderThickness="1.5"
                        CornerRadius="10" Padding="18,14" BoxShadow="0 6 20 #40000000" IsVisible="True">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Engine Icon Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#142c44" BorderBrush="#008bb9" BorderThickness="1"
                                Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Name="TxtQuickIcon" Text="📁" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Connection Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Name="TxtQuickName" Text="Conexão" FontSize="17" FontWeight="Bold" Foreground="#f0f6fc"/>
                                <Border Name="BadgeQuickSaved" Background="#064e3b" BorderBrush="#10b981" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="SALVA" FontSize="9.5" FontWeight="Bold" Foreground="#34d399"/>
                                </Border>
                                <Border Name="BadgeQuickEngine" Background="#142c44" BorderBrush="#38bdf8" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Name="TxtQuickEngineTag" Text="SQLITE" FontSize="9.5" FontWeight="Bold" Foreground="#38bdf8"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Name="TxtQuickDetails" Text="demo.db" FontSize="12" Foreground="#8b9cb3"/>
                        </StackPanel>

                        <!-- Action Buttons (Immediately Accessible without Scrolling!) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Name="BtnQuickTestTop" Content="{DynamicResource Connection.Test}" Classes="btn-outline" 
                                    Padding="14,10" FontSize="12"
                                    AutomationProperties.Name="Testar Conexão Rápida"
                                    ToolTip.Tip="Testar se o banco de dados responde antes de conectar"/>
                            <Button Name="BtnQuickConnectTop" Classes="btn-primary" 
                                    Padding="22,10" FontSize="13" FontWeight="Bold"
                                    AutomationProperties.Name="Conectar Imediatamente">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Connection.QuickConnect}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Connecting Progress Bar -->
                <ProgressBar Name="ProgressConnecting" Height="3" IsIndeterminate="True" IsVisible="False" 
                             Foreground="#008bb9" Background="#0e141f" Margin="0,-10,0,0"/>

                <!-- Status Banner & Diagnostics Chips (Hidden by default) -->
                <Border Name="BorderStatus" Background="#141d2b" BorderThickness="1" BorderBrush="#008bb9" 
                        CornerRadius="6" Padding="14,10" IsVisible="False"
                        AutomationProperties.LiveSetting="Polite">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Name="TxtStatusMessage" Grid.Column="0" Text="Status" Foreground="#f0f6fc" FontSize="13" TextWrapping="Wrap"
                                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                        <StackPanel Name="PanelDiagnosticsChips" Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="False" VerticalAlignment="Center">
                            <!-- Latency Badge -->
                            <Border Name="BadgeLatency" Background="#064e3b" BorderBrush="#34d399" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Name="TxtDiagnosticLatency" Text="⚡ 12 ms" FontSize="10.5" FontWeight="Bold" Foreground="#34d399"/>
                            </Border>
                            <!-- Server Version Badge -->
                            <Border Name="BadgeVersion" Background="#1e293b" BorderBrush="#475569" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Name="TxtDiagnosticVersion" Text="Database Server" FontSize="10.5" FontWeight="SemiBold" Foreground="#cbd5e1"/>
                            </Border>
                            <!-- Encryption Badge -->
                            <Border Name="BadgeEncryption" Background="#0c2338" BorderBrush="#1d578c" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Name="TxtDiagnosticEncryption" Text="🔒 TLS" FontSize="10.5" FontWeight="SemiBold" Foreground="#7dd3fc"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Connection Name & Category -->
                <Grid ColumnDefinitions="1.4*,*">
                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                        <TextBlock Text="{DynamicResource Connection.Name}" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                        <TextBox Name="TxtConnectionName" Background="#0e141f" Foreground="#f0f6fc" BorderBrush="#1e2d42" 
                                 CornerRadius="6" Padding="10,8" Watermark="{DynamicResource Connection.NameWatermark}"
                                 AutomationProperties.Name="{DynamicResource A11y.ConnectionName}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                        <TextBlock Text="{DynamicResource Connection.CategoryLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Name="TxtConnectionCategory" Grid.Column="0" Background="#0e141f" Foreground="#f0f6fc"
                                     BorderBrush="#1e2d42" CornerRadius="6,0,0,6" Padding="10,8"
                                     Watermark="{DynamicResource Connection.CategoryWatermark}"
                                     AutomationProperties.Name="{DynamicResource A11y.ConnectionCategory}"/>
                            <Button Name="BtnCategoryPresets" Grid.Column="1" Content="📂 ▼" Classes="btn-secondary"
                                    Padding="10,8" CornerRadius="0,6,6,0" FontSize="11"
                                    AutomationProperties.Name="Selecionar categoria existente"
                                    ToolTip.Tip="Selecionar uma categoria existente ou sugerida">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight"/>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Database Engine Selection (Modern Dropdown) -->
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Connection.Engine}" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtEngineMatchCount" Grid.Column="1" Text="5 motores suportados" FontSize="11" Foreground="#64748b" VerticalAlignment="Center"/>
                    </Grid>

                    <ComboBox Name="CmbDatabaseEngine" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Center"
                              MinHeight="46"
                              Background="#0e141f" Foreground="#f0f6fc" BorderBrush="#1e2d42"
                              CornerRadius="8" Padding="12,4"
                              AutomationProperties.Name="Selecionar motor de banco de dados">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="uiModels:DatabaseEngineOption">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,2">
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6" Background="{Binding IconBackground}" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <PathIcon Data="{Binding IconData}" Width="18" Height="18" Foreground="{Binding IconForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5" Foreground="#f0f6fc"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#8b9cb3"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{Binding BadgeBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- SQLITE FORM SECTION -->
                <StackPanel Name="PanelSqliteForm" Spacing="14" IsVisible="True">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource Connection.FilePath}" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Name="TxtSqlitePath" Grid.Column="0" Background="#0e141f" Foreground="#f0f6fc" 
                                     BorderBrush="#1e2d42" CornerRadius="6,0,0,6" Padding="10,8"
                                     Watermark="/path/to/database.db or demo.db"
                                     AutomationProperties.Name="{DynamicResource A11y.SqliteFilePath}"/>
                            <Button Name="BtnBrowseSqlite" Grid.Column="1" Content="{DynamicResource Connection.Browse}" 
                                    Classes="btn-secondary" Padding="14,8" CornerRadius="0,6,6,0"
                                    AutomationProperties.Name="{DynamicResource A11y.BrowseSqliteFile}"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Connection.TipFile}" FontSize="11" Foreground="#5a6f87"/>
                </StackPanel>

                <!-- POSTGRESQL FORM SECTION (Organized in 2 Distinct Tabs: Direct & SSH Tunnel) -->
                <StackPanel Name="PanelPostgresForm" Spacing="8" IsVisible="False">
                    <TabControl Name="TabsPostgresConnection" Background="Transparent" BorderThickness="0" Padding="0">
                        <!-- TAB 1: CONEXÃO DIRETA / GERAL -->
                        <TabItem FontSize="12" FontWeight="SemiBold">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Connection.TabDirect}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Border Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="8" Padding="14,14" Margin="0,8,0,0">
                                <StackPanel Spacing="12">
                                    <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <TextBlock Text="{DynamicResource Connection.TabDirectDesc}" FontSize="11" Foreground="#64748b" TextWrapping="Wrap"/>
                                    </Border>

                                    <Grid ColumnDefinitions="3*,*">
                                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                            <TextBlock Text="{DynamicResource Connection.Host}" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                                            <TextBox Name="TxtPgHost" Text="localhost" Background="#090d14" Foreground="#f0f6fc" 
                                                     BorderBrush="#1e2d42" CornerRadius="6" Padding="10,8"
                                                     AutomationProperties.Name="{DynamicResource A11y.Host}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                            <TextBlock Text="{DynamicResource Connection.Port}" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                                            <TextBox Name="TxtPgPort" Text="5432" Background="#090d14" Foreground="#f0f6fc" 
                                                     BorderBrush="#1e2d42" CornerRadius="6" Padding="10,8"
                                                     AutomationProperties.Name="{DynamicResource A11y.Port}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="6">
                                        <TextBlock Name="LblPgDatabase" Text="{DynamicResource Connection.Database}" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                                        <TextBox Name="TxtPgDatabase" Text="postgres" Background="#090d14" Foreground="#f0f6fc" 
                                                 BorderBrush="#1e2d42" CornerRadius="6" Padding="10,8"
                                                 AutomationProperties.Name="{DynamicResource A11y.DatabaseName}"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                            <TextBlock Text="{DynamicResource Connection.Username}" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                                            <TextBox Name="TxtPgUser" Text="postgres" Background="#090d14" Foreground="#f0f6fc" 
                                                     BorderBrush="#1e2d42" CornerRadius="6" Padding="10,8"
                                                     AutomationProperties.Name="{DynamicResource A11y.Username}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{DynamicResource Connection.Password}" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                                                <Border Background="#122a20" BorderBrush="#34d399" BorderThickness="1" CornerRadius="4" Padding="5,1"
                                                        ToolTip.Tip="Credenciais salvas em disco são criptografadas com AES-256-GCM + PBKDF2">
                                                    <TextBlock Text="🔒 AES-256-GCM" FontSize="9" FontWeight="Bold" Foreground="#34d399"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBox Name="TxtPgPassword" PasswordChar="•" Background="#090d14" Foreground="#f0f6fc" 
                                                     BorderBrush="#1e2d42" CornerRadius="6" Padding="10,8"
                                                     AutomationProperties.Name="{DynamicResource A11y.Password}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{DynamicResource Connection.SslMode}" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                                        <ComboBox Name="ComboPgSsl" SelectedIndex="1" HorizontalAlignment="Stretch" 
                                                  Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42"
                                                  AutomationProperties.Name="{DynamicResource A11y.SslMode}">
                                            <ComboBoxItem Content="Disable"/>
                                            <ComboBoxItem Content="Prefer"/>
                                            <ComboBoxItem Content="Require"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- SQL SERVER SPECIFIC OPTIONS (Visible only when SQL Server is selected) -->
                                    <StackPanel Name="PanelSqlServerOptions" Spacing="10" IsVisible="False" Margin="0,4,0,0">
                                        <Border Background="#1f1315" BorderBrush="#7f1d1d" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="🏢" FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Connection.SqlServerOptionsTitle}" FontWeight="SemiBold" FontSize="12" Foreground="#f87171" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{DynamicResource Connection.DefaultSchema}" FontSize="11" Foreground="#8b9cb3"/>
                                                    <TextBox Name="TxtDefaultSchema" Text="dbo" Watermark="dbo" Background="#090d14" Foreground="#f0f6fc"
                                                             BorderBrush="#1e2d42" CornerRadius="6" Padding="8,6"
                                                             AutomationProperties.Name="{DynamicResource Connection.DefaultSchema}"/>
                                                </StackPanel>

                                                <CheckBox Name="ChkTrustServerCert" IsChecked="True"
                                                          Content="{DynamicResource Connection.TrustServerCertificate}"
                                                          FontSize="11.5" Foreground="#f0f6fc"
                                                          ToolTip.Tip="Habilita TrustServerCertificate=True na connection string do SQL Server (recomendado para instâncias locais, Docker ou certificados autoassinados)"
                                                          AutomationProperties.Name="{DynamicResource Connection.TrustServerCertificate}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- ORACLE SPECIFIC OPTIONS (Visible only when Oracle is selected) -->
                                    <StackPanel Name="PanelOracleOptions" Spacing="10" IsVisible="False" Margin="0,4,0,0">
                                        <Border Background="#1a0c0e" BorderBrush="#7f1d1d" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="🔴" FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Connection.OracleOptionsTitle}" FontWeight="SemiBold" FontSize="12" Foreground="#f87171" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Tipo de Conexão: Service Name vs SID vs TNS -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{DynamicResource Connection.OracleConnectionType}" FontSize="11" Foreground="#8b9cb3"/>
                                                    <ComboBox Name="CmbOracleConnectionType" SelectedIndex="0" HorizontalAlignment="Stretch"
                                                              Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5">
                                                        <ComboBoxItem Content="{DynamicResource Connection.OracleTypeServiceName}"/>
                                                        <ComboBoxItem Content="{DynamicResource Connection.OracleTypeSid}"/>
                                                        <ComboBoxItem Content="{DynamicResource Connection.OracleTypeTns}"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- TNS Descriptor Multiline Box -->
                                                <StackPanel Name="PanelOracleTnsField" Spacing="4" IsVisible="False">
                                                    <TextBlock Text="{DynamicResource Connection.OracleTnsLabel}" FontSize="11" Foreground="#8b9cb3"/>
                                                    <TextBox Name="TxtOracleTns" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                                             Watermark="{DynamicResource Connection.OracleTnsPlaceholder}"
                                                             Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"/>
                                                </StackPanel>

                                                <!-- Privilégio Administrativo: Normal vs SYSDBA vs SYSOPER -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{DynamicResource Connection.OraclePrivilegeLabel}" FontSize="11" Foreground="#8b9cb3"/>
                                                    <ComboBox Name="CmbOraclePrivilege" SelectedIndex="0" HorizontalAlignment="Stretch"
                                                              Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5">
                                                        <ComboBoxItem Content="{DynamicResource Connection.OraclePrivilegeNormal}"/>
                                                        <ComboBoxItem Content="{DynamicResource Connection.OraclePrivilegeSysDba}"/>
                                                        <ComboBoxItem Content="{DynamicResource Connection.OraclePrivilegeSysOper}"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Aviso SYSDBA / SYSOPER -->
                                                <Border Name="BorderOraclePrivilegeWarning" Background="#2e1a0c" BorderBrush="#d97706" BorderThickness="1"
                                                        CornerRadius="5" Padding="8,6" IsVisible="False">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="⚠️" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Connection.OraclePrivilegeWarning}"
                                                                   FontSize="10.5" Foreground="#fcd34d" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </TabItem>

                        <!-- TAB 2: TÚNEL SSH / BASTION HOST -->
                        <TabItem FontSize="12" FontWeight="SemiBold">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="🔐" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Connection.TabSsh}" VerticalAlignment="Center"/>
                                    <Border Name="BadgeSshTabActive" Background="#065f46" BorderBrush="#34d399" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" IsVisible="False">
                                        <TextBlock Text="ATIVO" FontSize="9" FontWeight="Bold" Foreground="#34d399"/>
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>

                            <Border Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="8" Padding="14,14" Margin="0,8,0,0">
                                <StackPanel Spacing="12">
                                    <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <TextBlock Text="{DynamicResource Connection.TabSshDesc}" FontSize="11" Foreground="#64748b" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- SSH Tunnel Active Mode Banner (Sem necessidade de marcar checkbox) -->
                                    <Border Background="#062e26" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="🔐" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Modo Túnel SSH (Bastion Host) Ativo" FontSize="12" FontWeight="Bold" Foreground="#34d399"/>
                                                <TextBlock Text="O RUNIX conectará através deste servidor intermediário usando uma porta local efêmera automática." FontSize="11" Foreground="#a7f3d0"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#022c22" BorderBrush="#10b981" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="ATIVO NESTA ABA" FontSize="10" FontWeight="Bold" Foreground="#34d399"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Form de Configuração SSH (Sempre exibido ao abrir a aba) -->
                                    <StackPanel Name="PanelSshConfigFields" Spacing="10" IsVisible="True">
                                        <Grid ColumnDefinitions="3*,*">
                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                                <TextBlock Text="Host SSH (Bastion / Jump Server)" FontSize="11" Foreground="#8b9cb3"/>
                                                <TextBox Name="TxtSshHost" Watermark="bastion.empresa.com" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"
                                                         AutomationProperties.Name="{DynamicResource A11y.SshHost}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                                <TextBlock Text="Porta SSH" FontSize="11" Foreground="#8b9cb3"/>
                                                <TextBox Name="TxtSshPort" Text="22" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"
                                                         AutomationProperties.Name="{DynamicResource A11y.SshPort}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                                <TextBlock Text="Usuário SSH" FontSize="11" Foreground="#8b9cb3"/>
                                                <TextBox Name="TxtSshUsername" Watermark="ubuntu / ec2-user" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"
                                                         AutomationProperties.Name="{DynamicResource A11y.SshUsername}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                                <TextBlock Text="Método de Autenticação SSH" FontSize="11" Foreground="#8b9cb3"/>
                                                <ComboBox Name="ComboSshAuthMethod" SelectedIndex="0" HorizontalAlignment="Stretch" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42"
                                                          AutomationProperties.Name="Método de Autenticação SSH">
                                                    <ComboBoxItem Content="Senha (Password)"/>
                                                    <ComboBoxItem Content="Chave Privada (.pem / id_ed25519 / id_rsa)"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- SSH Password Mode -->
                                        <StackPanel Name="PanelSshPasswordAuth" Spacing="4">
                                            <TextBlock Text="Senha SSH (Criptografada com AES-256-GCM)" FontSize="11" Foreground="#8b9cb3"/>
                                            <TextBox Name="TxtSshPassword" PasswordChar="•" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"
                                                     AutomationProperties.Name="{DynamicResource A11y.SshPassword}"/>
                                        </StackPanel>

                                        <!-- SSH Private Key Mode -->
                                        <StackPanel Name="PanelSshKeyAuth" Spacing="8" IsVisible="False">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Caminho da Chave Privada (.pem / id_rsa / id_ed25519)" FontSize="11" Foreground="#8b9cb3"/>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBox Name="TxtSshKeyPath" Grid.Column="0" Watermark="~/.ssh/id_ed25519" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5,0,0,5" Padding="8,6"
                                                             AutomationProperties.Name="{DynamicResource A11y.SshKeyFile}"/>
                                                    <Button Name="BtnBrowseSshKey" Grid.Column="1" Content="Procurar..." Classes="btn-secondary" Padding="10,6" CornerRadius="0,5,5,0"
                                                            AutomationProperties.Name="{DynamicResource A11y.BrowseSshKey}"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Passphrase da Chave (Opcional — Criptografada com AES-256-GCM)" FontSize="11" Foreground="#8b9cb3"/>
                                                <TextBox Name="TxtSshKeyPassphrase" PasswordChar="•" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"
                                                         AutomationProperties.Name="Passphrase da Chave Privada SSH"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Target Database Forwarding Note -->
                                        <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Grid.Column="0" Text="🎯" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="O túnel SSH encaminhará o tráfego com segurança para o Host, Porta, Banco e Usuário configurados na aba Conexão Direta."
                                                           FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </TabItem>
                    </TabControl>
                </StackPanel>

                <!-- SAFETY & PROTECTION SETTINGS (v1.2.0) -->
                <Border Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,4,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="SEGURANÇA &amp; PROTEÇÃO DO BANCO" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" LetterSpacing="0.5"/>
                        <Grid ColumnDefinitions="*,*">
                            <!-- Read-Only Connection Lock -->
                            <CheckBox Name="ChkReadOnly" Grid.Column="0"
                                      Content="🔒 Modo Somente-Leitura (Read-Only Lock)"
                                      FontSize="11.5" FontWeight="SemiBold" Foreground="#cbd5e1"
                                      ToolTip.Tip="Bloqueia estritamente qualquer instrução de escrita (INSERT, UPDATE, DELETE, DROP, ALTER) nesta conexão"
                                      AutomationProperties.Name="Modo Somente-Leitura"/>

                            <!-- Production Safeguards & Alert Banner -->
                            <CheckBox Name="ChkProduction" Grid.Column="1"
                                      Content="🚨 Ambiente de Produção (Alerta &amp; Bloqueio)"
                                      FontSize="11.5" FontWeight="SemiBold" Foreground="#f87171"
                                      ToolTip.Tip="Exibe borda/badge de alerta vermelho na barra de topo e bloqueia DROP, TRUNCATE e UPDATE/DELETE sem WHERE"
                                      AutomationProperties.Name="Ambiente de Produção com Alerta"/>
                        </Grid>
                        <TextBlock Name="TxtProductionNotice" Text="💡 Conexões em Produção exibem alerta visual e bloqueiam DROP, TRUNCATE e UPDATE/DELETE sem WHERE."
                                   FontSize="10.5" Foreground="#64748b" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ACTION BUTTONS -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                    <Button Name="BtnDeleteConnection" Grid.Column="0" Content="{DynamicResource Common.Delete}" 
                            Classes="btn-danger" Padding="16,10" IsVisible="False"
                            AutomationProperties.Name="{DynamicResource A11y.DeleteConnection}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Name="BtnTestConnection" Content="{DynamicResource Connection.Test}" 
                            Classes="btn-outline" Padding="16,10"
                            AutomationProperties.Name="{DynamicResource A11y.TestConnection}"/>

                        <Button Name="BtnSaveConnection" Content="{DynamicResource Common.Save}" 
                            Classes="btn-secondary" Padding="18,10"
                            AutomationProperties.Name="{DynamicResource A11y.SaveConnection}"/>

                        <Button Name="BtnConnect" Content="{DynamicResource Connection.Connect}" 
                            Classes="btn-primary" Padding="26,10"
                            AutomationProperties.Name="{DynamicResource A11y.Connect}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- MODAL OVERLAY CONTAINER (Export / Import .RCF) -->
        <Grid Name="PanelModalOverlay" Grid.ColumnSpan="3" Background="#b8000000" IsVisible="False" ZIndex="200">
            <ContentControl Name="ModalContainer" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>

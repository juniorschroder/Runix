<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:chart="clr-namespace:Runix.Desktop.Views.Chart"
             xmlns:views="clr-namespace:Runix.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Runix.Desktop.Views.TableDataTabControl"
             Background="#090d14">

    <UserControl.Styles>
        <!-- Column Header Styling -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#0e141f"/>
            <Setter Property="Foreground" Value="#8b9cb3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="#1e2d42"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <!-- Cell and Row Typography and Styling -->
        <Style Selector="DataGridCell">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#151f2e"/>
        </Style>

        <Style Selector="DataGridRow">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Background" Value="#090d14"/>
        </Style>

        <!-- Cell editing TextBox styling -->
        <Style Selector="DataGridCell TextBox">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Background" Value="#0a0f17"/>
            <Setter Property="Foreground" Value="#f0f6fc"/>
            <Setter Property="BorderBrush" Value="#008bb9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <Style Selector="DataGridRow[Tag=Modified]">
            <Setter Property="Background" Value="#292004"/>
        </Style>
        <Style Selector="DataGridRow[Tag=Added]">
            <Setter Property="Background" Value="#04271c"/>
        </Style>
        <Style Selector="DataGridRow[Tag=Deleted]">
            <Setter Property="Background" Value="#2f0707"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
        <Style Selector="DataGridRow[Tag=Deleted] TextBlock">
            <Setter Property="TextDecorations" Value="Strikethrough"/>
            <Setter Property="Foreground" Value="#f87171"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,36">
        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="#141d2b" Padding="12,8" BorderBrush="#1e2d42" BorderThickness="0,0,0,1">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Linha 1: Título da Tabela, Filtro SQL e Botão Filtros por Coluna -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Name="TxtTableName" Grid.Column="0" Text="Table Name" FontWeight="Bold" FontSize="14" 
                               Foreground="#008bb9" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <!-- Filter Box -->
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,10,0" MinWidth="180" MaxWidth="520" HorizontalAlignment="Left">
                        <TextBox Name="TxtFilter" Grid.Column="0" Watermark="{DynamicResource TableData.FilterPlaceholder}" 
                                 Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5,0,0,5" 
                                 Padding="8,5" FontSize="11"
                                 AutomationProperties.Name="{DynamicResource A11y.FilterTableData}"/>
                        <Button Name="BtnApplyFilter" Grid.Column="1" Content="{DynamicResource TableData.FilterButton}" 
                                 Classes="btn-secondary" Padding="10,5" CornerRadius="0,5,5,0" FontSize="11"
                                 AutomationProperties.Name="Aplicar Filtro"/>
                    </Grid>

                    <!-- Toggle Column Filters Button -->
                    <Button Name="BtnToggleColumnFilters" Grid.Column="2" Content="🔍 Filtros por Coluna" 
                            Classes="btn-outline" Padding="8,5" FontSize="11" HorizontalAlignment="Right"
                            AutomationProperties.Name="Alternar Barra de Filtros Inline por Coluna"
                            ToolTip.Tip="Alternar exibição da barra de filtros rápidos por coluna (ex: > 100, LIKE '%abc%', IS NULL)"/>
                </Grid>

                <!-- Linha 2: Ações da Tabela com quebra automática (WrapPanel) responsiva -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Name="BtnAddRow" Content="{DynamicResource TableData.AddRow}" 
                            Classes="btn-accent-subtle" Padding="10,5" FontSize="11" Margin="0,2,6,4"
                            AutomationProperties.Name="{DynamicResource A11y.AddRow}"/>

                    <Button Name="BtnDeleteRow" Content="{DynamicResource TableData.DeleteRow}" 
                            Classes="btn-danger" Padding="10,5" FontSize="11" Margin="0,2,6,4"
                            AutomationProperties.Name="{DynamicResource A11y.DeleteRow}"/>

                    <Button Name="BtnRefresh" Content="{DynamicResource Workspace.Refresh}" 
                            Classes="btn-outline" Padding="8,5" FontSize="11" Margin="0,2,6,4"
                            AutomationProperties.Name="{DynamicResource A11y.RefreshData}"/>

                    <Button Name="BtnExportData" Content="{DynamicResource Query.Export}" 
                            Classes="btn-secondary" Padding="10,5" FontSize="11" Margin="0,2,6,4"
                            AutomationProperties.Name="{DynamicResource A11y.ExportResults}"/>

                    <Button Name="BtnImportData" Content="{DynamicResource TableData.Import}" 
                            Classes="btn-secondary" Padding="10,5" FontSize="11" Margin="0,2,6,4"
                            AutomationProperties.Name="Importar Dados para a Tabela"/>

                    <Button Name="BtnGenerateMockData" Content="🎲 Mock Data" 
                            Classes="btn-outline" Padding="10,5" FontSize="11" Margin="0,2,6,4"
                            AutomationProperties.Name="Gerar Dados Fictícios (Mock Data)"
                            ToolTip.Tip="Gerar dados de teste sintéticos com amostragem de FK"/>

                    <Button Name="BtnToggleChart" Content="📈 Gráfico" 
                            Classes="btn-outline" Padding="10,5" FontSize="11" Margin="0,2,6,4"
                            AutomationProperties.Name="Alternar visualização em Gráfico"/>

                    <Button Name="BtnToggleInspector" Content="🔬 Inspetor" 
                            Classes="btn-outline" Padding="10,5" FontSize="11" Margin="0,2,6,4"
                            AutomationProperties.Name="Alternar Inspetor de Célula e Linha"
                            ToolTip.Tip="Inspetor Lateral de Linha / Célula (JSON, TEXT, BLOB)"/>

                    <Button Name="BtnViewStructure" Content="{DynamicResource TableData.StructureButton}" 
                            Classes="btn-accent-subtle" Padding="10,5" FontSize="11" Margin="0,2,6,4"
                            AutomationProperties.Name="Ver Estrutura e DDL da Tabela"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- INLINE COLUMN FILTERS BAR (Oculto por default) -->
        <Border Name="BarInlineColumnFilters" Grid.Row="1" Background="#0c111a" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="12,10,12,12" IsVisible="False">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🔍 Filtros Inline por Coluna:" FontSize="11.5" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                        <TextBlock Text="(ex: > 100, LIKE '%abc%', IS NULL, IS NOT NULL)" FontSize="10.5" Foreground="#64748b" VerticalAlignment="Center"/>
                        <Border Name="BadgeActiveFiltersCount" Background="#064e3b" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" IsVisible="False">
                            <TextBlock Name="TxtActiveFiltersCount" Text="0 ativos" FontSize="9.5" FontWeight="Bold" Foreground="#34d399"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Name="BtnApplyInlineFilters" Content="Filtrar" Classes="btn-primary" Padding="12,4" FontSize="11"
                                AutomationProperties.Name="Aplicar Filtros por Coluna"/>
                        <Button Name="BtnClearInlineFilters" Content="Limpar Filtros" Classes="btn-outline" Padding="10,4" FontSize="11"
                                AutomationProperties.Name="Limpar Filtros por Coluna"/>
                    </StackPanel>
                </Grid>

                <!-- Scrollable Row of Column Filter TextBoxes com respiro para a barra de rolagem horizontal -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,16">
                    <StackPanel Name="PanelColumnFiltersHost" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- FOREIGN KEY QUICK NAV BAR (1-Click FK Navigation) -->
        <Border Name="BarForeignKeyQuickNav" Grid.Row="2" Background="#0c2238" BorderBrush="#0284c7" BorderThickness="0,0,0,1" Padding="12,6" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="🔗" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtForeignKeyInfo" Text="Chave Estrangeira detectada" FontSize="11.5" FontWeight="SemiBold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Name="BtnQuickNavigateFk" Content="↗ Ir para registro referenciado (FK)" Classes="btn-primary" Padding="12,4" FontSize="11"
                            AutomationProperties.Name="Ir para Registro Referenciado pela Chave Estrangeira"/>
                    <Button Name="BtnCloseFkQuickNav" Content="✕" Classes="btn-outline" Padding="6,4" FontSize="11"
                            AutomationProperties.Name="Fechar Barra de Chave Estrangeira"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DATA GRID, CHART & RECORD INSPECTOR DRAWER -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Background="#090d14">
            <Grid Grid.Column="0">
                <DataGrid Name="GridTableRows" AutoGenerateColumns="False" IsReadOnly="False" 
                          SelectionMode="Single"
                          GridLinesVisibility="All" HeadersVisibility="Column"
                          HorizontalGridLinesBrush="#151f2e" VerticalGridLinesBrush="#151f2e"
                          BorderThickness="0" Background="#090d14" Foreground="#f0f6fc"
                          RowBackground="#090d14" FontSize="11.5"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          AutomationProperties.Name="Tabela de Dados Interativa">
                    <DataGrid.ContextMenu>
                        <ContextMenu Name="MenuGridCell">
                            <MenuItem Name="MenuCopyCellValue" Header="📋 Copiar Valor da Célula"/>
                            <MenuItem Name="MenuFilterByCellValue" Header="🔍 Filtrar por este Valor"/>
                            <Separator Name="SepFkNavigation"/>
                            <MenuItem Name="MenuNavigateForeignKey" Header="🔗 Ir para Registro Referenciado (FK)" IsVisible="False"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <ProgressBar Name="ProgressLoading" IsIndeterminate="True" Width="200" Height="4" 
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" Foreground="#008bb9"/>

                <!-- SkiaChartControl -->
                <chart:SkiaChartControl Name="ViewChart" IsVisible="False"/>
            </Grid>

            <views:RecordInspectorDrawer Name="DrawerInspector" Grid.Column="1" Width="340" IsVisible="False"/>
        </Grid>

        <!-- STAGING ACTION BAR -->
        <Border Name="PanelStagingBar" Grid.Row="4" Background="#1c1608" BorderBrush="#fbbf24" BorderThickness="0,1,0,1" Padding="14,8" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtStagedCount" Text="0 pending changes" FontWeight="SemiBold" FontSize="12" Foreground="#fbbf24" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Name="TxtWarningNoPk" Text="{DynamicResource TableData.NoPkWarning}" FontSize="11" Foreground="#f59e0b" VerticalAlignment="Center" IsVisible="False" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Status / Error message banner inline -->
                <TextBlock Name="TxtStatusBanner" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Margin="16,0" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite"/>

                <Button Name="BtnDiscardChanges" Grid.Column="2" Content="{DynamicResource TableData.DiscardChanges}"
                        Classes="btn-danger" Padding="14,6" Margin="0,0,10,0"
                        AutomationProperties.Name="{DynamicResource A11y.DiscardStagedChanges}"/>

                <Button Name="BtnCommitChanges" Grid.Column="3" Content="{DynamicResource TableData.SaveChanges}"
                        Classes="btn-success" Padding="16,6"
                        AutomationProperties.Name="{DynamicResource A11y.SaveStagedChanges}"/>
            </Grid>
        </Border>

        <!-- BOTTOM PAGINATION & STATS BAR -->
        <Border Grid.Row="5" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,1,0,0" Padding="14,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="TxtPaginationInfo" Text="Showing 0 rows" VerticalAlignment="Center" FontSize="11" Foreground="#8b9cb3"
                           AutomationProperties.LiveSetting="Polite"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Name="BtnPrevPage" Content="{DynamicResource TableData.Previous}" Classes="btn-secondary" Padding="10,4" FontSize="11"
                            AutomationProperties.Name="{DynamicResource A11y.PrevPage}"/>
                    <TextBlock Name="TxtPageNumber" Text="Page 1" VerticalAlignment="Center" FontSize="11" Foreground="#f0f6fc"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button Name="BtnNextPage" Content="{DynamicResource TableData.Next}" Classes="btn-secondary" Padding="10,4" FontSize="11"
                            AutomationProperties.Name="{DynamicResource A11y.NextPage}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MODAL OVERLAY FOR EXPORT DIALOG -->
        <Grid Name="PanelModalOverlay" Grid.RowSpan="6" Background="#b0000000" IsVisible="False" ZIndex="100">
            <ContentControl Name="ModalContainer" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>

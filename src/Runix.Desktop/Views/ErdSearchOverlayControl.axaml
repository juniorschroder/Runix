<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Runix.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="Runix.Desktop.Views.ErdSearchOverlayControl">

    <Border Width="380" MaxHeight="380" Background="#0e141f" BorderBrush="#008bb9" BorderThickness="1.5"
            CornerRadius="8" BoxShadow="0 10 30 3 #B0000000" Padding="0">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Search Header -->
            <Border Grid.Row="0" Background="#090d14" BorderBrush="#1e2d42" BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0" Padding="12,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="#38bdf8"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Name="TxtSearch" Grid.Column="1"
                             Watermark="{DynamicResource Erd.Search.Placeholder}"
                             Background="Transparent" Foreground="#f0f6fc" BorderThickness="0"
                             FontSize="12" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Buscar tabelas ou colunas no diagrama"/>
                    <Button Name="BtnClose" Grid.Column="2" Content="ESC" Classes="btn-outline"
                            Padding="6,2" FontSize="10" VerticalAlignment="Center"
                            AutomationProperties.Name="Fechar busca do diagrama"/>
                </Grid>
            </Border>

            <!-- Results List -->
            <ListBox Name="ListResults" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Margin="4,4" MaxHeight="250"
                     AutomationProperties.Name="Resultados da busca no diagrama">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="views:ErdSearchItem">
                        <Border Padding="8,5" CornerRadius="4" Margin="0,1" Background="Transparent">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="12"
                                           Foreground="#f0f6fc" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding SecondaryText}" FontSize="10"
                                           Foreground="#64748b" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty Results Notice -->
            <TextBlock Name="TxtNoResults" Grid.Row="1" Text="{DynamicResource Erd.Search.NoResults}"
                       Foreground="#64748b" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="16" IsVisible="False"/>

            <!-- Footer Hints -->
            <Border Grid.Row="2" Background="#090d14" BorderBrush="#1e2d42" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8" Padding="10,6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="↑↓ navegar  •  ↵ focar no canvas" FontSize="10" Foreground="#64748b" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtResultCount" Grid.Column="1" Text="0 itens" FontSize="10" Foreground="#38bdf8" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

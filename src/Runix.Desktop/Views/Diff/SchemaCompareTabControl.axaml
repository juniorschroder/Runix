<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:diff="clr-namespace:Runix.Desktop.Views.Diff"
             xmlns:diffModels="clr-namespace:Runix.Core.Models.Diff;assembly=Runix.Core"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             x:Class="Runix.Desktop.Views.Diff.SchemaCompareTabControl"
             Background="#090d14">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <!-- TOP TOOLBAR: DUAL ENDPOINTS (SOURCE / SWAP / TARGET / OPTIONS) -->
        <Border Grid.Row="0" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                <!-- Source Endpoint -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Origem:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                    <ComboBox Name="CboSource" Width="200" Padding="8,4" FontSize="11"
                              Background="#141d2b" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="4"/>
                    <Button Name="BtnBrowseSourceSnapshot" Content="📂" Classes="btn-outline" Padding="8,4" FontSize="11"
                            ToolTip.Tip="Carregar arquivo snapshot (.rschema / .json) para Origem"/>
                    <Button Name="BtnSaveSnapshot" Content="📸" Classes="btn-outline" Padding="8,4" FontSize="11"
                            ToolTip.Tip="Capturar snapshot da conexão atual (.rschema)"/>
                </StackPanel>

                <!-- Direction Swap Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0,8,0">
                    <Button Name="BtnSwapEndpoints" Content="⇄" Classes="btn-secondary" Padding="8,4" FontSize="12"
                            ToolTip.Tip="{DynamicResource Diff.Endpoints.Swap}"/>
                </StackPanel>

                <!-- Target Endpoint -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Destino:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                    <ComboBox Name="CboTarget" Width="200" Padding="8,4" FontSize="11"
                              Background="#141d2b" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="4"/>
                    <Button Name="BtnBrowseTargetSnapshot" Content="📂" Classes="btn-outline" Padding="8,4" FontSize="11"
                            ToolTip.Tip="Carregar arquivo snapshot (.rschema / .json) para Destino"/>
                </StackPanel>

                <!-- Strict Types Toggle -->
                <CheckBox Name="ChkStrictTypes" Grid.Column="4" Content="{DynamicResource Diff.Endpoints.StrictTypes}" IsChecked="False"
                          FontSize="11" Foreground="#93c5fd" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                          ToolTip.Tip="Desativa equivalência semântica tolerante entre SQLite e PostgreSQL"/>

                <!-- Safe Mode Checkbox -->
                <CheckBox Name="ChkSafeMode" Grid.Column="5" Content="Modo Seguro" IsChecked="True"
                          FontSize="11" Foreground="#34d399" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"
                          ToolTip.Tip="Comenta comandos DROP TABLE e DROP COLUMN para evitar perda acidental de dados"/>

                <!-- Compare Action Button -->
                <Button Name="BtnCompare" Grid.Column="6" Content="⚖ Comparar Schemas ⚡" Classes="btn-primary" Padding="14,6" FontSize="11"/>
            </Grid>
        </Border>

        <!-- INTEGRITY COMPROMISED WARNING BANNER -->
        <Border Name="PanelCompromisedWarning" Grid.Row="1" Background="#451a03" BorderBrush="#f59e0b" BorderThickness="1"
                CornerRadius="5" Padding="12,8" Margin="14,4,14,0" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{DynamicResource Snapshot.CompromisedWarning}"
                           Foreground="#fbbf24" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Name="BtnDismissCompromisedWarning" Grid.Column="2" Content="✕" Classes="btn-icon" FontSize="11"
                        VerticalAlignment="Center" ToolTip.Tip="Fechar aviso"/>
            </Grid>
        </Border>

        <!-- STATS & SELECTION FILTER TOOLBAR -->
        <Border Grid.Row="2" Background="#0c111a" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
                <!-- Status Badges -->
                <TextBlock Name="TxtSummaryTotal" Grid.Column="0" Text="Total: 0" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Name="TxtSummaryAdded" Grid.Column="1" Text="+ 0 Novos" FontSize="11" Foreground="#34d399" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Name="TxtSummaryModified" Grid.Column="2" Text="~ 0 Modificados" FontSize="11" Foreground="#fbbf24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Name="TxtSummaryRemoved" Grid.Column="3" Text="- 0 Extras" FontSize="11" Foreground="#f87171" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <!-- Selection Shortcuts -->
                <Button Name="BtnSelectAll" Grid.Column="5" Content="✓ Todos" Classes="btn-outline" Padding="8,4" FontSize="10" Margin="0,0,4,0"/>
                <Button Name="BtnDeselectAll" Grid.Column="6" Content="✕ Nenhum" Classes="btn-outline" Padding="8,4" FontSize="10" Margin="0,0,4,0"/>
                <Button Name="BtnSelectAdditions" Grid.Column="7" Content="+ Apenas Novos" Classes="btn-outline" Padding="8,4" FontSize="10" Margin="0,0,10,0"/>

                <!-- Filter Box -->
                <TextBox Name="TxtFilterTable" Grid.Column="8" Width="180" Watermark="Filtrar tabela..."
                         Background="#141d2b" Foreground="#f0f6fc" BorderBrush="#1e2d42" Padding="8,4" FontSize="11" CornerRadius="4"/>
            </Grid>
        </Border>

        <!-- MAIN COMPARISON SPLIT VIEW: TABLES LIST (TOP) & INSPECTOR (BOTTOM) -->
        <Grid Grid.Row="3" RowDefinitions="*,1,260">
            <!-- TABLES LIST -->
            <Grid Grid.Row="0">
                <DataGrid Name="GridTableDiffs" x:DataType="diffModels:TableDiffItem" AutoGenerateColumns="False" IsReadOnly="False"
                          Background="#090d14" GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          BorderThickness="0" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <!-- Sync Checkbox -->
                        <DataGridCheckBoxColumn Header="Sincronizar" Binding="{Binding IsSelectedForSync}" Width="90"/>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="diffModels:TableDiffItem">
                                    <Border Background="#162235" CornerRadius="4" Padding="6,2" Margin="4,2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StatusBadge}" Foreground="{Binding StatusColor}"
                                                   FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Esquema" Binding="{Binding Schema}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nome da Tabela" Binding="{Binding Name}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Resumo das Divergências" Binding="{Binding Summary}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Banner -->
                <Border Name="PanelEmptyDiff" Background="#0d131f" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="8" Padding="24" IsVisible="True" BorderBrush="#1e2d42" BorderThickness="1">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="⚖" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nenhum diff de schema carregado." FontSize="14" FontWeight="Bold" Foreground="#f0f6fc" HorizontalAlignment="Center"/>
                        <TextBlock Text="Selecione a Origem e o Destino (conexões ativas, salvas ou snapshots .rschema) e clique em 'Comparar Schemas'."
                                   FontSize="11" Foreground="#8b9cb3" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SPLITTER -->
            <GridSplitter Grid.Row="1" Background="#1e2d42" ResizeDirection="Rows"/>

            <!-- INSPECTOR PANEL -->
            <Grid Grid.Row="2" Background="#0b1018" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="🔍 Inspetor de Estrutura:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                            <TextBlock Name="TxtInspectorTableName" Text="(Nenhuma tabela selecionada)" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Name="TxtInspectorColCount" Grid.Column="1" Text="0 colunas divergentes" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Column Inspector Grid -->
                <DataGrid Name="GridColumnDiffs" x:DataType="diffModels:ColumnDiffItem" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="#0b1018" GridLinesVisibility="Horizontal"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Coluna" Binding="{Binding ColumnName}" Width="160"/>
                        <DataGridTemplateColumn Header="Ação" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="diffModels:ColumnDiffItem">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                        <Border Background="#162235" CornerRadius="4" Padding="6,2" Margin="2,2">
                                            <TextBlock Text="{Binding StatusBadge}" Foreground="{Binding StatusColor}"
                                                       FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#0e2f3d" BorderBrush="#06b6d4" BorderThickness="1" CornerRadius="4" 
                                                Padding="4,2" Margin="2,2" IsVisible="{Binding IsCrossDialectCompatible}"
                                                ToolTip.Tip="{Binding DialectNote}">
                                            <TextBlock Text="⇄ Dialeto" Foreground="#22d3ee" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Tipo na Origem" Binding="{Binding SourceType}" Width="140"/>
                        <DataGridTextColumn Header="Tipo no Destino" Binding="{Binding TargetType}" Width="140"/>
                        <DataGridTextColumn Header="Divergência Detalhada" Binding="{Binding DifferenceDescription}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- BOTTOM STAGING ACTION BAR -->
        <Border Grid.Row="4" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="⚡ Sincronização:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtStagingCount" Text="0 tabelas selecionadas" FontSize="11" FontWeight="Bold" Foreground="#34d399" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Name="BtnGenerateSync" Grid.Column="1" Content="⚡ Gerar Script de Sincronização"
                        Classes="btn-primary" Padding="16,8" FontSize="11" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="5" Background="#090d14" BorderBrush="#1e2d42" BorderThickness="0,1,0,0" Padding="14,4">
            <TextBlock Name="TxtStatusMessage" Text="Pronto para comparar schemas." FontSize="11" Foreground="#8b9cb3"/>
        </Border>

        <!-- MODAL OVERLAY (Sync Preview, Snapshot Capture, Integrity Error) -->
        <Grid Name="PanelModalOverlay" Grid.RowSpan="6" Background="#b0000000" IsVisible="False" ZIndex="100">
            <diff:SyncPreviewDialog Name="ModalSyncPreview" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
            <ContentControl Name="ModalContainer" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>

            <!-- Integrity Error Modal Dialog with Force Open -->
            <Border Name="PanelIntegrityModal" Background="#141d2b" BorderBrush="#f59e0b" BorderThickness="1.5" 
                    CornerRadius="10" Padding="20" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚠️" FontSize="20"/>
                        <TextBlock Text="Integridade do Snapshot Comprometida" FontSize="15" FontWeight="Bold" Foreground="#fbbf24"/>
                    </StackPanel>
                    <TextBlock Name="TxtIntegrityErrorDetails" FontSize="11" Foreground="#f0f6fc" TextWrapping="Wrap"/>
                    <TextBlock Text="O checksum SHA-256 divergiu do hash registrado no cabeçalho do envelope. O arquivo pode ter sido corrompido ou adulterado externamente. Você pode cancelar ou forçar a abertura por sua conta e risco." 
                               FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Name="BtnCancelIntegrityModal" Grid.Column="1" Content="{DynamicResource Common.Cancel}" Classes="btn-secondary" Padding="14,6" Margin="0,0,8,0"/>
                        <Button Name="BtnForceOpenSnapshot" Grid.Column="2" Content="{DynamicResource Snapshot.ForceOpenButton}" Classes="btn-danger" Padding="14,6" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

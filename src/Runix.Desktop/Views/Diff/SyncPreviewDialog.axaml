<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="600"
             x:Class="Runix.Desktop.Views.Diff.SyncPreviewDialog">

    <Border Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="8"
            Padding="20" Width="760" MaxHeight="620" BoxShadow="0 8 32 #50000000">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- HEADER -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⚡" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="Script DDL de Sincronização" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Name="BtnCloseTop" Grid.Column="1" Content="✕" Classes="btn-outline" Padding="8,4" FontSize="11"/>
            </Grid>

            <!-- SAFE MODE WARNING BANNER -->
            <Border Name="PanelSafeWarning" Grid.Row="1" Background="#2d1515" BorderBrush="#ef4444" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,12" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="ATENÇÃO: Modo Seguro desativado. Este script contém operações destrutivas (DROP) que removerão objetos existentes."
                               Foreground="#f87171" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- SQL VIEWER -->
            <Border Grid.Row="2" Background="#090d14" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer MaxHeight="380" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBox Name="TxtSqlScript" IsReadOnly="True" FontFamily="Consolas, Menlo, Monaco, monospace"
                             Background="Transparent" BorderThickness="0" Foreground="#38bdf8" FontSize="12" TextWrapping="NoWrap"/>
                </ScrollViewer>
            </Border>

            <!-- FOOTER ACTIONS -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="0,14,0,0">
                <TextBlock Name="TxtExecutionStatus" Grid.Column="0" Text="" FontSize="11" Foreground="#34d399" VerticalAlignment="Center"/>

                <Button Name="BtnCopySql" Grid.Column="2" Content="📋 Copiar SQL" Classes="btn-secondary" Padding="14,7" Margin="0,0,8,0" FontSize="11"/>
                <Button Name="BtnSaveFile" Grid.Column="3" Content="💾 Salvar .sql" Classes="btn-outline" Padding="14,7" Margin="0,0,8,0" FontSize="11"/>
                <Button Name="BtnSaveSnapshot" Grid.Column="4" Content="{DynamicResource Diff.Endpoints.SaveUpdatedSnapshot}" Classes="btn-outline" Padding="14,7" Margin="0,0,8,0" FontSize="11" IsVisible="False"/>
                <Button Name="BtnExecute" Grid.Column="5" Content="⚡ Executar no Destino" Classes="btn-primary" Padding="16,7" FontSize="11"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>

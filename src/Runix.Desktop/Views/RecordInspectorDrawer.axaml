<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Runix.Core.Models;assembly=Runix.Core"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="550"
             x:Class="Runix.Desktop.Views.RecordInspectorDrawer"
             Background="#0e141f">

    <Border BorderBrush="#1e2d42" BorderThickness="1,0,0,0" Background="#0e141f">
        <Grid RowDefinitions="Auto,*,5,*,Auto">
            <!-- Header -->
            <Border Grid.Row="0" Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="10,7">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="🔬" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Inspetor de Linha / Célula" FontWeight="Bold" FontSize="11.5" Foreground="#f0f6fc" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Name="BtnCloseDrawer" Grid.Column="1" Content="✕" Classes="btn-icon" Padding="5,2" FontSize="10"/>
                </Grid>
            </Border>

            <!-- Top Half: Vertical Field List of Selected Row -->
            <ListBox Name="ListFields" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="4">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:InspectedCellField">
                        <Border Padding="8,5" CornerRadius="4" Margin="0,1" Background="#090d14" BorderBrush="#151f2e" BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Background="#141d2b" CornerRadius="3" Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CategoryBadge}" Foreground="{Binding CategoryColor}" FontSize="9" FontWeight="Bold" FontFamily="Consolas,monospace"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{Binding ColumnName}" FontSize="10.5" FontWeight="Bold" Foreground="#38bdf8" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplayPreview}" FontSize="11" Foreground="#cbd5e1" TextTrimming="CharacterEllipsis" FontFamily="Consolas,monospace"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ByteOrCharLength, StringFormat='{}{0}B'}" FontSize="9" Foreground="#64748b" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Splitter -->
            <GridSplitter Grid.Row="2" Background="#1e2d42" ResizeDirection="Rows" HorizontalAlignment="Stretch"/>

            <!-- Bottom Half: Detailed Value Viewer / Editor (JSON Pretty-Print, Hex Dump, Long Text) -->
            <Grid Grid.Row="3" RowDefinitions="Auto,*" Background="#090d14">
                <Border Grid.Row="0" Background="#101826" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="8,5">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Name="TxtActiveColumnName" Grid.Column="0" Text="Selecione um campo" FontSize="11" FontWeight="SemiBold" Foreground="#38bdf8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Name="BtnJsonPretty" Content="✨ JSON" Classes="btn-outline" Padding="6,2" FontSize="10" ToolTip.Tip="Formatar JSON (Pretty-Print)"/>
                            <Button Name="BtnJsonMinify" Content="📦 Minify" Classes="btn-outline" Padding="6,2" FontSize="10" ToolTip.Tip="Compactar JSON em 1 linha"/>
                            <Button Name="BtnCopyValue" Content="📋 Copiar" Classes="btn-secondary" Padding="6,2" FontSize="10"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBox Name="TxtValueEditor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                         Background="#090d14" Foreground="#f0f6fc" BorderThickness="0" Padding="10,8"
                         FontFamily="Consolas,Menlo,Monaco,monospace" FontSize="11.5"/>
            </Grid>

            <!-- Footer Status & Apply Button (for editable grids) -->
            <Border Grid.Row="4" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,1,0,0" Padding="10,6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Name="TxtStatus" Grid.Column="0" Text="Pronto" FontSize="10" Foreground="#8b9cb3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Name="BtnApplyEdit" Grid.Column="1" Content="💾 Aplicar na Célula" Classes="btn-primary" Padding="10,4" FontSize="10.5" IsVisible="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

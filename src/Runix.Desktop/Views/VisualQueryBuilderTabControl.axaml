<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Runix.Core.Models"
             xmlns:qb="using:Runix.Desktop.Views.QueryBuilder"
             xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Runix.Desktop.Views.VisualQueryBuilderTabControl"
             Background="#090d14">

    <Grid RowDefinitions="Auto,380,5,*,30">
        <!-- 1. TOP TOOLBAR: BASE TABLE, OPTIONS & ACTIONS -->
        <Border Grid.Row="0" Background="#141d2b" Padding="14,8" BorderBrush="#1e2d42" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,3,14,3">
                    <Border Background="#008bb9" CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                        <TextBlock Text="🧩 VISUAL QUERY BUILDER" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Active Engine Dialect Badge -->
                    <Border Name="BadgeEngineDialect" Background="#101927" BorderBrush="#38bdf8" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Name="TxtEngineDialect" Text="[SQLite Dialect]" FontSize="10" FontWeight="Bold" Foreground="#38bdf8"/>
                    </Border>

                    <TextBlock Text="Tabela Base (FROM):" FontSize="11" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                    <ComboBox Name="CmbBaseTable" Width="180" FontSize="11" PlaceholderText="Selecione a tabela..."/>

                    <CheckBox Name="ChkDistinct" Content="DISTINCT" FontSize="11" Foreground="#cbd5e1" VerticalAlignment="Center"/>

                    <TextBlock Text="LIMIT:" FontSize="11" Foreground="#cbd5e1" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox Name="TxtLimit" Text="100" Width="55" FontSize="11" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42"/>

                    <TextBlock Text="OFFSET:" FontSize="11" Foreground="#cbd5e1" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox Name="TxtOffset" Text="0" Width="50" FontSize="11" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,3,0,3">
                    <Button Name="BtnRunVisualQuery" Content="▶ Executar Consulta" Classes="btn-primary" Padding="12,5" FontSize="11"/>
                    <Button Name="BtnOpenInEditor" Content="📝 Abrir no Editor SQL" Classes="btn-secondary" Padding="10,5" FontSize="11"
                            ToolTip.Tip="Envia o SQL construído para uma aba completa do Editor SQL"/>
                    <Button Name="BtnCopySql" Content="📋 Copiar SQL" Classes="btn-secondary" Padding="10,5" FontSize="11"/>
                    <Button Name="BtnResetBuilder" Content="🔄 Limpar" Classes="btn-outline" Padding="10,5" FontSize="11"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 2. MIDDLE CONFIGURATION & LIVE SQL PREVIEW -->
        <Grid Grid.Row="1" ColumnDefinitions="1.5*,1.1*" Background="#0e141f">
            <!-- PANE LEFT: 4 WORKSPACE TABS -->
            <Border Grid.Column="0" BorderBrush="#1e2d42" BorderThickness="0,0,1,0" Padding="8,6">
                <TabControl Name="TabControlSections">
                    <!-- TAB 1: COLUMNS & GROUP BY -->
                    <TabItem Header="📋 Colunas &amp; Agrupamento" FontSize="11.5">
                        <Grid RowDefinitions="Auto,*" Margin="0,6,0,0">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
                                <TextBlock Text="Selecione as colunas, funções agregadoras e critérios de agrupamento:" FontSize="11" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Name="BtnSelectAllCols" Content="Selecionar Todas" Classes="btn-outline" Padding="8,3" FontSize="10.5" Margin="0,0,4,0"/>
                                <Button Grid.Column="3" Name="BtnClearAllCols" Content="Desmarcar Todas" Classes="btn-outline" Padding="8,3" FontSize="10.5"/>
                            </Grid>
                            <Border Grid.Row="1" Background="#090d14" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="5" Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="ItemsSelectColumns">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:VisualSelectColumn">
                                                <Border Padding="6,3" Margin="0,1" CornerRadius="3" Background="#141d2b">
                                                    <Grid ColumnDefinitions="Auto,*,125,115,Auto">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="2,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayExpression}" FontSize="11" Foreground="#f0f6fc" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBox Grid.Column="2" Text="{Binding AggregateFunction}" Watermark="COUNT/SUM..." FontSize="10.5" Margin="4,0" Padding="4,2" Background="#090d14" Foreground="#38bdf8"/>
                                                        <TextBox Grid.Column="3" Text="{Binding OutputAlias}" Watermark="Alias (AS)" FontSize="10.5" Margin="4,0" Padding="4,2" Background="#090d14" Foreground="#cbd5e1"/>
                                                        <CheckBox Grid.Column="4" Content="Group By" IsChecked="{Binding IsGroupBy}" FontSize="10" Foreground="#a78bfa" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: JOINS -->
                    <TabItem Header="🔗 Junções Relacionais" FontSize="11.5">
                        <Grid RowDefinitions="Auto,*" Margin="0,6,0,0">
                            <Grid Grid.Row="0" ColumnDefinitions="130,*,Auto,Auto" Margin="0,0,0,8">
                                <ComboBox Grid.Column="0" Name="CmbJoinType" SelectedIndex="0" FontSize="10.5" Margin="0,0,4,0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="INNER JOIN"/>
                                    <ComboBoxItem Content="LEFT JOIN"/>
                                    <ComboBoxItem Content="RIGHT JOIN"/>
                                    <ComboBoxItem Content="FULL OUTER JOIN"/>
                                    <ComboBoxItem Content="CROSS JOIN"/>
                                </ComboBox>
                                <ComboBox Grid.Column="1" Name="CmbJoinTable" FontSize="10.5" PlaceholderText="Selecione a tabela para Junção..." Margin="0,0,4,0" HorizontalAlignment="Stretch"/>
                                <Button Grid.Column="2" Name="BtnAddJoin" Content="+ Adicionar Join" Classes="btn-secondary" Padding="10,4" FontSize="10.5" Margin="0,0,4,0"/>
                                <Button Grid.Column="3" Name="BtnSuggestFkJoins" Content="🔗 Sugerir FKs" Classes="btn-outline" Padding="8,4" FontSize="10.5"/>
                            </Grid>
                            <Border Grid.Row="1" Background="#090d14" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="5" Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="ItemsJoins">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:VisualJoinClause">
                                                <Border Padding="6,4" Margin="0,2" CornerRadius="4" Background="#141d2b">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto">
                                                        <Border Grid.Column="0" Background="#008bb9" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding JoinType}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <TextBox Grid.Column="1" Text="{Binding SourceColumn}" FontSize="10.5" Padding="4,2" Background="#090d14" Foreground="#f0f6fc" ToolTip.Tip="Coluna Origem"/>
                                                        <TextBlock Grid.Column="2" Text=" = " FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center" Margin="4,0"/>
                                                        <TextBox Grid.Column="3" Text="{Binding TargetColumn}" FontSize="10.5" Padding="4,2" Background="#090d14" Foreground="#f0f6fc" ToolTip.Tip="Coluna Destino"/>
                                                        <Border Grid.Column="4" Background="#1e293b" CornerRadius="3" Padding="6,2" Margin="6,0">
                                                            <TextBlock Text="{Binding RelationshipDescription}" FontSize="10" Foreground="#38bdf8"/>
                                                        </Border>
                                                        <Button Grid.Column="5" Name="BtnRemoveJoin" Content="✕" Classes="btn-icon" Padding="6,2" FontSize="10.5" Foreground="#f87171"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: FILTERS (WHERE & HAVING) -->
                    <TabItem Header="🌲 Filtros (WHERE &amp; HAVING)" FontSize="11.5">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <StackPanel Spacing="10" Margin="0,0,6,0">
                                <!-- WHERE SECTION -->
                                <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="🌲" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="Cláusula WHERE (Árvore de Condições Recursivas)" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Grupos aninhados AND / OR e NOT" FontSize="10.5" Foreground="#64748b" VerticalAlignment="Center" Grid.Column="1"/>
                                        </Grid>
                                        <qb:FilterGroupView Name="ViewWhereFilterTree"/>
                                    </StackPanel>
                                </Border>

                                <!-- HAVING SECTION -->
                                <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="⚖️" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="Cláusula HAVING (Filtros de Agregação Pós-Agrupamento)" FontSize="11" FontWeight="Bold" Foreground="#fbbf24" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Filtra expressões agregadas (ex: COUNT(*) > 5)" FontSize="10.5" Foreground="#64748b" VerticalAlignment="Center" Grid.Column="1"/>
                                        </Grid>
                                        <qb:FilterGroupView Name="ViewHavingFilterTree"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 4: ORDER BY -->
                    <TabItem Header="🔀 Ordenação (ORDER BY)" FontSize="11.5">
                        <Grid RowDefinitions="Auto,*" Margin="0,6,0,0">
                            <Grid Grid.Row="0" ColumnDefinitions="*,100,Auto" Margin="0,0,0,8">
                                <ComboBox Grid.Column="0" Name="CmbSortColumn" FontSize="10.5" PlaceholderText="Selecione a coluna para ordenar..." Margin="0,0,4,0" HorizontalAlignment="Stretch"/>
                                <ComboBox Grid.Column="1" Name="CmbSortDir" SelectedIndex="0" FontSize="10.5" Margin="0,0,4,0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="ASC"/>
                                    <ComboBoxItem Content="DESC"/>
                                </ComboBox>
                                <Button Grid.Column="2" Name="BtnAddSort" Content="+ Adicionar Ordem" Classes="btn-secondary" Padding="10,4" FontSize="10.5"/>
                            </Grid>
                            <Border Grid.Row="1" Background="#090d14" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="5" Padding="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="ItemsSorts">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:VisualSortClause">
                                                <Border Padding="6,3" Margin="0,1" CornerRadius="3" Background="#141d2b">
                                                    <Grid ColumnDefinitions="*,60,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding ColumnName}" FontSize="11" Foreground="#f0f6fc" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Direction}" FontSize="10.5" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Name="BtnRemoveSort" Content="✕" Classes="btn-icon" Padding="6,2" FontSize="10.5" Foreground="#f87171"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- PANE RIGHT: LIVE SQL PREVIEW -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Background="#090d14">
                <Border Grid.Row="0" Background="#141d2b" Padding="10,6" BorderBrush="#1e2d42" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="✨ Preview SQL Formatado em Tempo Real" FontSize="11" FontWeight="Bold" Foreground="#34d399" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtDialectIndicator" Grid.Column="1" Text="Dialeto Ativo" FontSize="10" Foreground="#64748b" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <AvaloniaEdit:TextEditor Grid.Row="1" Name="TxtGeneratedSql"
                                         Background="#090d14"
                                         Foreground="#f0f6fc"
                                         FontFamily="Consolas,Menlo,Monaco,monospace"
                                         FontSize="12"
                                         ShowLineNumbers="True"
                                         Padding="8,6"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>

        <!-- SPLITTER -->
        <GridSplitter Grid.Row="2" Background="#1e2d42" ResizeDirection="Rows" HorizontalAlignment="Stretch"/>

        <!-- 3. BOTTOM QUERY RESULTS DATAGRID -->
        <Grid Grid.Row="3" Background="#090d14">
            <DataGrid Name="GridResults" AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="All" BorderThickness="0" Background="#090d14" RowBackground="#0e141f"/>
            <TextBlock Name="TxtEmptyResultsHint"
                       Text="Configure sua consulta visualmente acima e clique em '▶ Executar Consulta' para visualizar os dados."
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748b" FontSize="12"/>
        </Grid>

        <!-- 4. FOOTER STATUS BAR -->
        <Border Grid.Row="4" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="TxtStatusSummary" Grid.Column="0" Text="Pronto" VerticalAlignment="Center" FontSize="11" Foreground="#8b9cb3"/>
                <TextBlock Name="TxtFkCountBadge" Grid.Column="1" Text="0 FKs mapeadas para Auto-Join" VerticalAlignment="Center" FontSize="11" Foreground="#38bdf8"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="clr-namespace:Runix.Desktop.Views.Dialogs"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="640"
             x:Class="Runix.Desktop.Views.Dialogs.ImportWizardDialog">

    <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1.5" CornerRadius="8" 
            Width="740" MaxHeight="640" Padding="20">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="📥" FontSize="18" Foreground="#38bdf8"/>
                    <TextBlock Name="TxtDialogTitle" Text="{DynamicResource Import.WizardTitle}" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc"/>
                    <Border Name="BadgeTargetTable" Background="#0c2338" BorderBrush="#16426a" BorderThickness="1" CornerRadius="4" Padding="6,2">
                        <TextBlock Name="TxtTargetTableName" Text="table" FontSize="11" Foreground="#38bdf8" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <Button Name="BtnClose" Grid.Column="1" Content="✕" Classes="btn-icon" FontSize="12"
                        AutomationProperties.Name="{DynamicResource A11y.CloseModal}"/>
            </Grid>

            <!-- Step Ribbon Indicators -->
            <Border Grid.Row="1" Background="#090d14" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                    <!-- Step 1 Indicator -->
                    <StackPanel Name="Step1Indicator" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <Border Name="BadgeStep1" Width="20" Height="20" CornerRadius="10" Background="#008bb9" VerticalAlignment="Center">
                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Name="TxtStep1Label" Text="{DynamicResource Import.Step1Title}" FontSize="12" FontWeight="SemiBold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="➔" FontSize="12" Foreground="#1e2d42" VerticalAlignment="Center"/>

                    <!-- Step 2 Indicator -->
                    <StackPanel Name="Step2Indicator" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <Border Name="BadgeStep2" Width="20" Height="20" CornerRadius="10" Background="#1e2d42" VerticalAlignment="Center">
                            <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="#8b9cb3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Name="TxtStep2Label" Text="{DynamicResource Import.Step2Title}" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="➔" FontSize="12" Foreground="#1e2d42" VerticalAlignment="Center"/>

                    <!-- Step 3 Indicator -->
                    <StackPanel Name="Step3Indicator" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                        <Border Name="BadgeStep3" Width="20" Height="20" CornerRadius="10" Background="#1e2d42" VerticalAlignment="Center">
                            <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="#8b9cb3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Name="TxtStep3Label" Text="{DynamicResource Import.Step3Title}" FontSize="12" FontWeight="SemiBold" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Wizard Body Content Area -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <!-- STEP 1: File & Detection -->
                <Grid Name="PanelStep1" RowDefinitions="Auto,Auto,*,Auto" IsVisible="True">
                    <!-- File Picker -->
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Import.SelectFile}" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Name="TxtFilePath" Grid.Column="0" IsReadOnly="True" Watermark="Selecione um arquivo CSV, JSON ou Excel (.xlsx)..."
                                     Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6" Margin="0,0,8,0"
                                     AutomationProperties.Name="Caminho do arquivo de dados para importação"/>
                            <Button Name="BtnBrowseFile" Grid.Column="1" Content="{DynamicResource Import.Browse}" Classes="btn-secondary" Padding="14,6"
                                    AutomationProperties.Name="Procurar arquivo para importação"/>
                        </Grid>
                    </StackPanel>

                    <!-- Format & Detection Bar -->
                    <Border Grid.Row="1" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Name="TxtDetectionBadge" Grid.Column="0" Text="Nenhum arquivo carregado." FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel Name="PanelDelimiterOverride" Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="False">
                                <TextBlock Text="Delimitador:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                                <ComboBox Name="CmbDelimiter" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="4" Padding="6,2" FontSize="11"
                                          AutomationProperties.Name="Delimitador do arquivo CSV">
                                    <ComboBoxItem Content="Auto" Tag="Auto" IsSelected="True"/>
                                    <ComboBoxItem Content="Vírgula (,)" Tag=","/>
                                    <ComboBoxItem Content="Ponto-e-vírgula (;)" Tag=";"/>
                                    <ComboBoxItem Content="Tabulação (\t)" Tag="&#x09;"/>
                                    <ComboBoxItem Content="Pipe (|)" Tag="|"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Preview Table -->
                    <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,8">
                        <TextBlock Text="Pré-visualização dos Dados (Primeiras Linhas):" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                        <Border Background="#090d14" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="5" Height="220">
                            <DataGrid Name="GridRawPreview" AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="All" HeadersVisibility="Column"
                                      HorizontalGridLinesBrush="#151f2e" VerticalGridLinesBrush="#151f2e"
                                      Background="#090d14" Foreground="#f0f6fc" RowBackground="#090d14"
                                      FontSize="11" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      AutomationProperties.Name="Tabela de pré-visualização dos dados do arquivo"/>
                        </Border>
                    </StackPanel>

                    <!-- Step 1 Inline Error Message -->
                    <TextBlock Name="TxtStep1Error" Grid.Row="3" Text="" Foreground="#f87171" FontSize="11" IsVisible="False"
                               AutomationProperties.LiveSetting="Assertive"/>
                </Grid>

                <!-- STEP 2: Column Mapping & Rules -->
                <Grid Name="PanelStep2" RowDefinitions="Auto,*,Auto" IsVisible="False">
                    <!-- Mapping Header & AutoMap Button -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Mapeamento de Colunas (Origem ➔ Tabela Destino)" FontSize="12" FontWeight="Bold" Foreground="#f0f6fc"/>
                            <TextBlock Text="Associe cada coluna do arquivo a um campo da tabela ou selecione &lt;Ignorar&gt;." FontSize="11" Foreground="#8b9cb3"/>
                        </StackPanel>
                        <Button Name="BtnAutoMap" Grid.Column="1" Content="⚡ Mapear Automaticamente" Classes="btn-accent-subtle" Padding="12,5" FontSize="11"
                                AutomationProperties.Name="Mapear colunas automaticamente"/>
                    </Grid>

                    <!-- Mapping Table -->
                    <Border Grid.Row="1" Background="#090d14" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="5" Height="230" Margin="0,0,0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl Name="ListColumnMappings">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="dialogs:ColumnMappingItem">
                                        <Border BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="10,6" Background="#090d14">
                                            <Grid ColumnDefinitions="160,30,200,90,Auto">
                                                <!-- Source Column Name -->
                                                <TextBlock Grid.Column="0" Text="{Binding SourceColumn}" FontWeight="SemiBold" FontSize="11.5" Foreground="#f0f6fc" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                
                                                <!-- Arrow -->
                                                <TextBlock Grid.Column="1" Text="➔" FontSize="12" Foreground="#8b9cb3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                
                                                <!-- Target Column ComboBox -->
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableTargetColumns}" SelectedItem="{Binding SelectedTargetColumn, Mode=TwoWay}"
                                                          Background="#141d2b" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="4" Padding="6,2" FontSize="11" HorizontalAlignment="Stretch"/>
                                                
                                                <!-- Target Data Type Badge -->
                                                <Border Grid.Column="3" Background="#141d2b" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding TargetDataType}" FontSize="10" Foreground="#38bdf8"/>
                                                </Border>

                                                <!-- Status Badge -->
                                                <Border Grid.Column="4" Background="#141d2b" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusBadge}" FontSize="10" Foreground="{Binding StatusColor}" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Execution Rules & Strategy -->
                    <Border Grid.Row="2" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="5" Padding="12,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Error Strategy Radios -->
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Estratégia de Tratamento de Erros:" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                                <RadioButton Name="RbRollbackOnError" Content="Reverter tudo se houver erro (Transacional)" GroupName="ImportStrategy" IsChecked="True" Foreground="#f0f6fc" FontSize="11.5"
                                             AutomationProperties.Name="Estratégia: Reverter tudo se houver erro"/>
                                <RadioButton Name="RbSkipErrors" Content="Ignorar linhas com erro e continuar (Linha a linha)" GroupName="ImportStrategy" Foreground="#f0f6fc" FontSize="11.5"
                                             AutomationProperties.Name="Estratégia: Ignorar linhas com erro e continuar"/>
                            </StackPanel>

                            <!-- Batch Size -->
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Tamanho do Lote:" FontSize="11" Foreground="#8b9cb3"/>
                                <TextBox Name="TxtBatchSize" Text="1000" Width="80" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="4" Padding="6,4" FontSize="11"
                                         AutomationProperties.Name="Tamanho do lote de importação"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- STEP 3: Execution & Progress -->
                <Grid Name="PanelStep3" RowDefinitions="Auto,Auto,Auto,*" IsVisible="False">
                    <!-- Status Progress Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Name="TxtProgressStatus" Grid.Column="0" Text="Importando dados..." FontSize="13" FontWeight="SemiBold" Foreground="#f0f6fc"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Name="TxtProgressPercentage" Grid.Column="1" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#38bdf8"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </Grid>

                    <!-- Progress Bar -->
                    <ProgressBar Name="ProgressBarImport" Grid.Row="1" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Foreground="#38bdf8" Background="#0e141f" CornerRadius="4" Margin="0,0,0,12"/>

                    <!-- Summary Card -->
                    <Border Name="PanelSummaryCard" Grid.Row="2" Background="#0c2338" BorderBrush="#16426a" BorderThickness="1" CornerRadius="6" Padding="14,10" IsVisible="False" Margin="0,0,0,10">
                        <StackPanel Spacing="4">
                            <TextBlock Name="TxtSummaryTitle" Text="✓ Importação Concluída" FontSize="13" FontWeight="Bold" Foreground="#34d399"/>
                            <TextBlock Name="TxtSummaryDetails" Text="0 linhas inseridas em 0 ms" FontSize="11.5" Foreground="#f0f6fc"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>

                    <!-- Errors Log -->
                    <Grid Grid.Row="3" RowDefinitions="Auto,*" Name="PanelErrorsLog" IsVisible="False">
                        <TextBlock Grid.Row="0" Text="Relatório de Erros / Inconsistências:" FontSize="11" FontWeight="SemiBold" Foreground="#f87171" Margin="0,0,0,6"/>
                        <Border Grid.Row="1" Background="#090d14" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="5" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl Name="ListErrors">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="x:String">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="#f87171" Margin="0,2" FontFamily="Consolas,Menlo,monospace"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Wizard Footer Buttons Bar -->
            <Border Grid.Row="3" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Name="BtnCancel" Grid.Column="0" Content="{DynamicResource Common.Cancel}" Classes="btn-outline" Padding="14,6"
                            AutomationProperties.Name="{DynamicResource Common.Cancel}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Name="BtnBack" Content="{DynamicResource Import.Back}" Classes="btn-secondary" Padding="14,6" IsVisible="False"
                                AutomationProperties.Name="Voltar etapa"/>
                        <Button Name="BtnNext" Content="{DynamicResource Import.Next}" Classes="btn-primary" Padding="16,6" IsEnabled="False"
                                AutomationProperties.Name="Avançar etapa"/>
                        <Button Name="BtnStartImport" Content="{DynamicResource Import.Start}" Classes="btn-primary" Padding="16,6" IsVisible="False"
                                AutomationProperties.Name="Iniciar importação"/>
                        <Button Name="BtnFinish" Content="{DynamicResource Common.Close}" Classes="btn-primary" Padding="16,6" IsVisible="False"
                                AutomationProperties.Name="{DynamicResource Common.Close}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
             x:Class="Runix.Desktop.Views.Dialogs.ForeignKeyDialog">

    <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1.5" CornerRadius="8" 
            Width="560" MaxHeight="550" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="🔗" FontSize="18"/>
                    <TextBlock Text="Novo Relacionamento (Foreign Key)" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc"/>
                </StackPanel>
                <Button Name="BtnClose" Grid.Column="1" Content="✕" Classes="btn-icon" FontSize="12"/>
            </Grid>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" Margin="0,0,0,14">
                <StackPanel Spacing="14">
                    <!-- Origin & Target Box -->
                    <Border Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto">
                            <!-- Source Table & Col -->
                            <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                                <TextBlock Text="TABELA ORIGEM" FontSize="10" FontWeight="Bold" Foreground="#8b9cb3"/>
                                <TextBlock Name="TxtSourceTable" Text="pedidos" FontSize="13" FontWeight="Bold" Foreground="#38bdf8"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Grid.Row="0" Text="→" FontSize="16" Foreground="#5a6f87" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>

                            <!-- Target Table -->
                            <StackPanel Grid.Column="2" Grid.Row="0" Spacing="4">
                                <TextBlock Text="TABELA DESTINO (REFERENCIADA)" FontSize="10" FontWeight="Bold" Foreground="#8b9cb3"/>
                                <ComboBox Name="CmbTargetTable" Background="#141d2b" Foreground="#f0f6fc" 
                                          BorderBrush="#1e2d42" CornerRadius="4" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- Source Col Picker -->
                            <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4" Margin="0,10,0,0">
                                <TextBlock Text="COLUNA ORIGEM (FK)" FontSize="10" FontWeight="Bold" Foreground="#8b9cb3"/>
                                <ComboBox Name="CmbSourceCol" Background="#141d2b" Foreground="#f0f6fc" 
                                          BorderBrush="#1e2d42" CornerRadius="4" HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- Target Col Picker -->
                            <StackPanel Grid.Column="2" Grid.Row="1" Spacing="4" Margin="0,10,0,0">
                                <TextBlock Text="COLUNA DESTINO (PK)" FontSize="10" FontWeight="Bold" Foreground="#8b9cb3"/>
                                <ComboBox Name="CmbTargetCol" Background="#141d2b" Foreground="#f0f6fc" 
                                          BorderBrush="#1e2d42" CornerRadius="4" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cardinality & Constraint Name -->
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                            <TextBlock Text="Cardinalidade" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                            <ComboBox Name="CmbCardinality" Background="#0e141f" Foreground="#f0f6fc" 
                                      BorderBrush="#1e2d42" CornerRadius="4" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Nome da Constraint" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                            <TextBox Name="TxtConstraintName" Background="#0e141f" Foreground="#f0f6fc" 
                                     BorderBrush="#1e2d42" CornerRadius="4" Padding="6,4"/>
                        </StackPanel>
                    </Grid>

                    <!-- Referential Integrity Rules (ON DELETE / ON UPDATE) -->
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                            <TextBlock Text="ON DELETE" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                            <ComboBox Name="CmbOnDelete" Background="#0e141f" Foreground="#f0f6fc" 
                                      BorderBrush="#1e2d42" CornerRadius="4" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="ON UPDATE" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                            <ComboBox Name="CmbOnUpdate" Background="#0e141f" Foreground="#f0f6fc" 
                                      BorderBrush="#1e2d42" CornerRadius="4" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Error Banner -->
            <Border Name="PanelValidation" Grid.Row="2" Background="#2c1517" BorderBrush="#f87171" BorderThickness="1" 
                    CornerRadius="5" Padding="10,6" Margin="0,0,0,14" IsVisible="False">
                <TextBlock Name="TxtValidationMessage" Foreground="#fca5a5" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <!-- Footer Buttons -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
                <Button Name="BtnCancel" Grid.Column="0" Content="Cancelar" Classes="btn-outline" Padding="14,8"/>
                <Button Name="BtnAdvancePreview" Grid.Column="2" Content="Avançar para Preview →" Classes="btn-primary" Padding="18,8"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="600"
             x:Class="Runix.Desktop.Views.Dialogs.MigrationPreviewDialog">

    <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1.5" CornerRadius="8" 
            Width="740" MaxHeight="600" Padding="20">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="18"/>
                    <TextBlock Text="Preview de Migração DDL" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc"/>
                    <Border Name="BadgeProvider" Background="#1a3a5c" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                        <TextBlock Name="TxtBadgeProvider" Text="SQLite" FontSize="11" FontWeight="Bold" Foreground="#38bdf8"/>
                    </Border>
                </StackPanel>
                <Button Name="BtnClose" Grid.Column="1" Content="✕" Classes="btn-icon" FontSize="12"/>
            </Grid>

            <!-- Rebuild Alert Banner (When Applicable) -->
            <Border Name="PanelRebuildWarning" Grid.Row="1" Background="#2b2314" BorderBrush="#eab308" BorderThickness="1" 
                    CornerRadius="6" Padding="10,8" Margin="0,0,0,12" IsVisible="False">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="O SQLite requer a recriação segura da tabela para esta alteração. Todos os dados existentes serão preservados automaticamente na migração." 
                               FontSize="11" Foreground="#fef08a" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- SQL Script Editor with Syntax Highlighting -->
            <Border Grid.Row="2" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,12">
                <AvaloniaEdit:TextEditor Name="EditorDdlPreview" 
                                         ShowLineNumbers="True" 
                                         IsReadOnly="True" 
                                         FontFamily="Consolas,Menlo,Monaco,monospace" 
                                         FontSize="12" 
                                         Background="Transparent" 
                                         Foreground="#f0f6fc"
                                         Height="260"/>
            </Border>

            <!-- Execution Status / Error Banner -->
            <Border Name="PanelStatus" Grid.Row="3" Background="#2c1517" BorderBrush="#f87171" BorderThickness="1" 
                    CornerRadius="6" Padding="10,8" Margin="0,0,0,12" IsVisible="False">
                <TextBlock Name="TxtStatusMessage" Foreground="#fca5a5" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <!-- Action Controls -->
            <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Name="BtnCancel" Grid.Column="0" Content="Cancelar" Classes="btn-outline" Padding="14,8"/>
                <Button Name="BtnCopyScript" Grid.Column="2" Content="Copiar Script" Classes="btn-secondary" Padding="14,8" Margin="0,0,8,0"/>
                <Button Name="BtnExecuteMigration" Grid.Column="3" Content="Executar Migração" Classes="btn-primary" Padding="18,8"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>

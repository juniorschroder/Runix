<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="Runix.Desktop.Views.Dialogs.TableEditorDialog">

    <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1.5" CornerRadius="8" 
            Width="680" MaxHeight="640" Padding="20">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="🗄" FontSize="18"/>
                    <TextBlock Name="TxtDialogTitle" Text="Nova Tabela" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc"/>
                </StackPanel>
                <Button Name="BtnClose" Grid.Column="1" Content="✕" Classes="btn-icon" FontSize="12"
                        AutomationProperties.Name="{DynamicResource A11y.CloseModal}"/>
            </Grid>

            <!-- Table & Schema Settings -->
            <Grid Grid.Row="1" ColumnDefinitions="2*,*" Margin="0,0,0,14">
                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                    <TextBlock Text="Nome da Tabela" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                    <TextBox Name="TxtTableName" Text="new_table" Background="#0e141f" Foreground="#f0f6fc" 
                             BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"
                             AutomationProperties.Name="Nome da Tabela"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Schema" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                    <TextBox Name="TxtSchema" Text="public" Background="#0e141f" Foreground="#f0f6fc" 
                             BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"
                             AutomationProperties.Name="Schema da Tabela"/>
                </StackPanel>
            </Grid>

            <!-- Columns Section -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,0,0,14">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="COLUNAS DA TABELA" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                    <Button Name="BtnAddColumn" Grid.Column="1" Content="+ Adicionar Coluna" Classes="btn-accent-subtle" FontSize="11" Padding="8,4"
                            AutomationProperties.Name="Adicionar Coluna à Tabela"/>
                </Grid>

                <Border Grid.Row="1" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="6">
                    <ScrollViewer MaxHeight="300">
                        <StackPanel Name="PanelColumnsContainer" Spacing="4"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Error Banner -->
            <Border Name="PanelValidation" Grid.Row="3" Background="#2c1517" BorderBrush="#f87171" BorderThickness="1" 
                    CornerRadius="5" Padding="10,6" Margin="0,0,0,14" IsVisible="False">
                <TextBlock Name="TxtValidationMessage" Foreground="#fca5a5" FontSize="11" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive"/>
            </Border>

            <!-- Footer Buttons -->
            <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto">
                <Button Name="BtnCancel" Grid.Column="0" Content="Cancelar" Classes="btn-outline" Padding="14,8"
                        AutomationProperties.Name="{DynamicResource Common.Cancel}"/>
                <Button Name="BtnAdvancePreview" Grid.Column="2" Content="Avançar para Preview →" Classes="btn-primary" Padding="18,8"
                        AutomationProperties.Name="Avançar para pré-visualização da migração"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>

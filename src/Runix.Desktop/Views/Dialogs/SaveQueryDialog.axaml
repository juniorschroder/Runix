<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
             x:Class="Runix.Desktop.Views.Dialogs.SaveQueryDialog">

    <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1.5" CornerRadius="8" 
            Width="560" MaxHeight="550" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="💾" FontSize="18"/>
                    <TextBlock Name="TxtDialogTitle" Text="Salvar Consulta na Biblioteca" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc"/>
                </StackPanel>
                <Button Name="BtnClose" Grid.Column="1" Content="✕" Classes="btn-icon" FontSize="12"/>
            </Grid>

            <!-- Form Body -->
            <ScrollViewer Grid.Row="1" Margin="0,0,0,12">
                <StackPanel Spacing="12">
                    <!-- Title -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Título da Consulta" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                        <TextBox Name="TxtTitle" Background="#0e141f" Foreground="#f0f6fc" 
                                 BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"
                                 Watermark="Ex: Relatório de Clientes Mensal"/>
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Descrição (Opcional)" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                        <TextBox Name="TxtDescription" Background="#0e141f" Foreground="#f0f6fc" 
                                 BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"
                                 Watermark="Ex: Filtra clientes que compraram no último mês"/>
                    </StackPanel>

                    <!-- Tags -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Tags (separadas por vírgula)" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                        <TextBox Name="TxtTags" Background="#0e141f" Foreground="#f0f6fc" 
                                 BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"
                                 Watermark="Ex: clientes, mensal, financeiro"/>
                    </StackPanel>

                    <!-- Favorite & Scope Options -->
                    <Grid ColumnDefinitions="*,*">
                        <CheckBox Name="ChkFavorite" Grid.Column="0" Content="Marcar como Favorita ⭐" 
                                  Foreground="#f0f6fc" FontSize="12" Margin="0,4"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <RadioButton Name="RbScopeCurrent" Content="Desta Conexão" GroupName="QueryScope" IsChecked="True" Foreground="#8b9cb3" FontSize="11"/>
                            <RadioButton Name="RbScopeGlobal" Content="Global" GroupName="QueryScope" Foreground="#8b9cb3" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- SQL Preview Box -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Comando SQL" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                        <TextBox Name="TxtSqlPreview" IsReadOnly="True" MaxHeight="100" AcceptsReturn="True" 
                                 FontFamily="Consolas,Menlo,Monaco,monospace" FontSize="11" 
                                 Background="#0e141f" Foreground="#38bdf8" BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Error Banner -->
            <Border Name="PanelValidation" Grid.Row="2" Background="#2c1517" BorderBrush="#f87171" BorderThickness="1" 
                    CornerRadius="5" Padding="10,6" Margin="0,0,0,12" IsVisible="False">
                <TextBlock Name="TxtValidationMessage" Foreground="#fca5a5" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <!-- Footer Buttons -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
                <Button Name="BtnCancel" Grid.Column="0" Content="Cancelar" Classes="btn-outline" Padding="14,8"/>
                <Button Name="BtnSave" Grid.Column="2" Content="Salvar Consulta" Classes="btn-primary" Padding="18,8"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>

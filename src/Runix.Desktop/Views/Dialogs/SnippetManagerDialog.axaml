<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Runix.Core.Models;assembly=Runix.Core"
             xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="580"
             x:Class="Runix.Desktop.Views.Dialogs.SnippetManagerDialog">

    <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1.5" CornerRadius="8" 
            Width="780" Height="560" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="✂" FontSize="18"/>
                        <TextBlock Text="Gerenciador de Snippets SQL" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc"/>
                    </StackPanel>
                    <TextBlock Text="Crie e gerencie atalhos personalizados que expandem no autocompletar do editor." 
                               FontSize="11" Foreground="#8b9cb3"/>
                </StackPanel>
                <Button Name="BtnClose" Grid.Column="1" Content="✕" Classes="btn-icon" FontSize="12" VerticalAlignment="Top"/>
            </Grid>

            <!-- Main Content: Left (Snippets List) | Right (Snippet Editor) -->
            <Grid Grid.Row="1" ColumnDefinitions="260,16,*" Margin="0,0,0,16">
                <!-- Left Column: Snippet List -->
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
                    <TextBox Name="TxtFilter" Grid.Row="0" Margin="0,0,0,8" 
                             Background="#0e141f" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5"
                             Watermark="🔍 Buscar snippets..." Padding="8,6" FontSize="11"/>

                    <Button Name="BtnNewSnippet" Grid.Row="1" Content="+ Novo Snippet" 
                            Classes="btn-accent-subtle" HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center" Margin="0,0,0,8" Padding="6,7"/>

                    <Border Grid.Row="2" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6">
                        <ListBox Name="ListSnippets" Background="Transparent" BorderThickness="0" Padding="4">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:CustomSnippet">
                                    <Border Padding="8,6" CornerRadius="4" Margin="0,2">
                                        <Grid RowDefinitions="Auto,Auto">
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
                                                <Border Background="#163854" CornerRadius="3" Padding="4,1">
                                                    <TextBlock Text="{Binding Prefix}" FontSize="11" FontWeight="Bold" Foreground="#38bdf8"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#f0f6fc" 
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="10" Foreground="#8b9cb3" 
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <!-- Separator -->
                <Rectangle Grid.Column="1" Width="1" Fill="#1e2d42" HorizontalAlignment="Center"/>

                <!-- Right Column: Edit Form -->
                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                    <!-- Prefix & Title in 2 columns -->
                    <Grid Grid.Row="0" ColumnDefinitions="140,12,*" Margin="0,0,0,10">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Prefixo de Atalho" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                            <TextBox Name="TxtPrefix" Background="#0e141f" Foreground="#38bdf8" FontWeight="Bold"
                                     BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6" Watermark="Ex: myjoin"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Título do Snippet" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                            <TextBox Name="TxtTitle" Background="#0e141f" Foreground="#f0f6fc" 
                                     BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6" Watermark="Ex: Inner Join com Filtro"/>
                        </StackPanel>
                    </Grid>

                    <!-- Description -->
                    <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,10">
                        <TextBlock Text="Descrição" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                        <TextBox Name="TxtDescription" Background="#0e141f" Foreground="#f0f6fc" 
                                 BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6" Watermark="Ex: Insere cláusula JOIN com alias e condição"/>
                    </StackPanel>

                    <!-- Code Body Label -->
                    <TextBlock Grid.Row="2" Text="Corpo do Snippet (Código SQL)" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3" Margin="0,0,0,4"/>

                    <!-- Code Body Editor -->
                    <Border Grid.Row="3" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="5" Margin="0,0,0,10">
                        <AvaloniaEdit:TextEditor Name="EditorSnippetBody" 
                                                 FontFamily="Consolas,Menlo,Monaco,Courier New,monospace"
                                                 FontSize="12"
                                                 Foreground="#f0f6fc"
                                                 Background="Transparent"
                                                 ShowLineNumbers="True"
                                                 WordWrap="False"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Padding="8"/>
                    </Border>

                    <!-- Validation Message -->
                    <Border Name="PanelValidation" Grid.Row="4" Background="#2c1517" BorderBrush="#f87171" BorderThickness="1" 
                            CornerRadius="5" Padding="10,6" Margin="0,0,0,10" IsVisible="False">
                        <TextBlock Name="TxtValidationMessage" Foreground="#fca5a5" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Form Buttons -->
                    <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto">
                        <Button Name="BtnDeleteSnippet" Grid.Column="0" Content="🗑 Excluir" Classes="btn-danger" Padding="12,6" IsVisible="False"/>
                        <Button Name="BtnSaveSnippet" Grid.Column="2" Content="💾 Salvar Snippet" Classes="btn-primary" Padding="16,6"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Dialog Footer -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <TextBlock Text="Dica: Digite o prefixo no editor SQL e selecione o snippet com Tab ou Enter." 
                           FontSize="11" Foreground="#64748b" VerticalAlignment="Center"/>
                <Button Name="BtnDone" Grid.Column="1" Content="Fechar" Classes="btn-secondary" Padding="18,7"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
             x:Class="Runix.Desktop.Views.Dialogs.ExportDialog">

    <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1.5" CornerRadius="8" 
            Width="560" MaxHeight="600" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="⤓" FontSize="18" Foreground="#38bdf8"/>
                    <TextBlock Name="TxtDialogTitle" Text="Exportar Dados" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc"/>
                </StackPanel>
                <Button Name="BtnClose" Grid.Column="1" Content="✕" Classes="btn-icon" FontSize="12"/>
            </Grid>

            <!-- Form Body -->
            <ScrollViewer Grid.Row="1" Margin="0,0,0,12">
                <StackPanel Spacing="14">
                    <!-- Format Selection -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Formato de Arquivo" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                        <Grid ColumnDefinitions="*,*,*,*">
                            <RadioButton Name="RbFormatCsv" Grid.Column="0" Content="📄 CSV" GroupName="ExportFormat" IsChecked="True" 
                                         Foreground="#f0f6fc" FontSize="12"/>
                            <RadioButton Name="RbFormatJson" Grid.Column="1" Content="📦 JSON" GroupName="ExportFormat" 
                                         Foreground="#f0f6fc" FontSize="12"/>
                            <RadioButton Name="RbFormatExcel" Grid.Column="2" Content="📊 Excel" GroupName="ExportFormat" 
                                         Foreground="#f0f6fc" FontSize="12"/>
                            <RadioButton Name="RbFormatSql" Grid.Column="3" Content="🗄 SQL Dump" GroupName="ExportFormat" 
                                         Foreground="#f0f6fc" FontSize="12"/>
                        </Grid>
                    </StackPanel>

                    <!-- Scope Selection -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Escopo dos Dados" FontSize="11" FontWeight="SemiBold" Foreground="#8b9cb3"/>
                        <Grid ColumnDefinitions="*,*">
                            <RadioButton Name="RbScopeCurrentPage" Grid.Column="0" Content="Página Atual (Visível)" 
                                         GroupName="ExportScope" IsChecked="True" Foreground="#f0f6fc" FontSize="12"/>
                            <RadioButton Name="RbScopeFull" Grid.Column="1" Content="Consulta/Tabela Completa (Streaming)" 
                                         GroupName="ExportScope" Foreground="#f0f6fc" FontSize="12"/>
                        </Grid>
                    </StackPanel>

                    <!-- Options Separator -->
                    <Rectangle Height="1" Fill="#1e2d42" HorizontalAlignment="Stretch"/>

                    <!-- CSV Options -->
                    <StackPanel Name="PanelCsvOptions" Spacing="10">
                        <TextBlock Text="Opções de CSV" FontSize="11" FontWeight="Bold" Foreground="#38bdf8"/>
                        <Grid ColumnDefinitions="120,*">
                            <TextBlock Text="Separador:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                            <ComboBox Name="CmbDelimiter" Grid.Column="1" HorizontalAlignment="Stretch"
                                      Background="#0e141f" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="5">
                                <ComboBoxItem Content="Vírgula (,)" Tag="Comma" IsSelected="True"/>
                                <ComboBoxItem Content="Ponto-e-vírgula (;)" Tag="Semicolon"/>
                                <ComboBoxItem Content="Tabulação (\t)" Tag="Tab"/>
                                <ComboBoxItem Content="Pipe (|)" Tag="Pipe"/>
                            </ComboBox>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Name="ChkCsvHeader" Content="Incluir Cabeçalho de Colunas" IsChecked="True" Foreground="#f0f6fc" FontSize="12"/>
                            <CheckBox Name="ChkCsvBom" Content="UTF-8 com BOM" IsChecked="False" Foreground="#f0f6fc" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- JSON Options -->
                    <StackPanel Name="PanelJsonOptions" Spacing="10" IsVisible="False">
                        <TextBlock Text="Opções de JSON" FontSize="11" FontWeight="Bold" Foreground="#38bdf8"/>
                        <Grid ColumnDefinitions="*,*">
                            <RadioButton Name="RbJsonObjects" Grid.Column="0" Content="Array de Objetos [ { ... } ]" 
                                         GroupName="JsonStyle" IsChecked="True" Foreground="#f0f6fc" FontSize="12"/>
                            <RadioButton Name="RbJsonTabular" Grid.Column="1" Content="Formato Tabular { col, rows }" 
                                         GroupName="JsonStyle" Foreground="#f0f6fc" FontSize="12"/>
                        </Grid>
                        <CheckBox Name="ChkJsonIndented" Content="Formatar com Indentação (Legível)" IsChecked="True" Foreground="#f0f6fc" FontSize="12"/>
                    </StackPanel>

                    <!-- Excel Options -->
                    <StackPanel Name="PanelExcelOptions" Spacing="10" IsVisible="False">
                        <TextBlock Text="Opções de Planilha Excel (.xlsx)" FontSize="11" FontWeight="Bold" Foreground="#38bdf8"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Nome da Aba (Sheet):" FontSize="11" Foreground="#8b9cb3"/>
                            <TextBox Name="TxtSheetName" Text="Data" Background="#0e141f" Foreground="#f0f6fc" 
                                     BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- SQL Dump Options -->
                    <StackPanel Name="PanelSqlOptions" Spacing="10" IsVisible="False">
                        <TextBlock Text="Opções de SQL Dump" FontSize="11" FontWeight="Bold" Foreground="#38bdf8"/>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Name="ChkSqlCreateTable" Content="Incluir CREATE TABLE IF NOT EXISTS" IsChecked="False" Foreground="#f0f6fc" FontSize="12"/>
                            <CheckBox Name="ChkSqlTransaction" Content="Transação Atômica (BEGIN/COMMIT)" IsChecked="True" Foreground="#f0f6fc" FontSize="12"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="140,*">
                            <TextBlock Text="Tamanho do Lote (INSERT):" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                            <TextBox Name="TxtSqlBatchSize" Grid.Column="1" Text="500" Background="#0e141f" Foreground="#f0f6fc" 
                                     BorderBrush="#1e2d42" CornerRadius="5" Padding="8,6"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Progress / Status Area -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12" Spacing="6">
                <ProgressBar Name="ProgressExport" Height="4" IsIndeterminate="True" IsVisible="False" 
                             Foreground="#008bb9" Background="#0e141f" CornerRadius="2"/>
                <TextBlock Name="TxtProgressStatus" FontSize="11" Foreground="#38bdf8" IsVisible="False"/>

                <!-- Validation / Error Banner -->
                <Border Name="PanelValidation" Background="#2c1517" BorderBrush="#f87171" BorderThickness="1" 
                        CornerRadius="5" Padding="10,6" IsVisible="False">
                    <TextBlock Name="TxtValidationMessage" Foreground="#fca5a5" FontSize="11" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- Footer Buttons -->
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
                <Button Name="BtnCancel" Grid.Column="0" Content="Cancelar" Classes="btn-outline" Padding="14,8"/>
                <Button Name="BtnExport" Grid.Column="2" Content="Escolher Destino e Exportar" Classes="btn-primary" Padding="18,8"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="480"
             x:Class="Runix.Desktop.Views.Dialogs.QueryParametersDialog">

    <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1.5" CornerRadius="8" 
            Width="540" MaxHeight="520" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="18"/>
                        <TextBlock Name="TxtDialogTitle" Text="Parâmetros da Consulta" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc"/>
                    </StackPanel>
                    <TextBlock Name="TxtDialogSubtitle" Text="Esta query contém variáveis dinâmicas. Preencha os valores para executar."
                               FontSize="11.5" Foreground="#8b9cb3" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Name="BtnClose" Grid.Column="1" Content="✕" Classes="btn-icon" FontSize="12"
                        AutomationProperties.Name="Fechar"/>
            </Grid>

            <!-- Dynamic Parameters List -->
            <ScrollViewer Grid.Row="1" Margin="0,4,0,14" MaxHeight="320">
                <StackPanel Name="PanelParametersList" Spacing="14"/>
            </ScrollViewer>

            <!-- Actions Footer -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                <TextBlock Text="Dica: Strings livres recebem aspas automáticas; números e NULL são mantidos literais."
                           FontSize="10.5" Foreground="#5a6f87" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                
                <Button Name="BtnCancel" Grid.Column="1" Content="Cancelar" Classes="btn-secondary" 
                        Padding="14,8" Margin="0,0,8,0"
                        AutomationProperties.Name="Cancelar Execução"/>
                
                <Button Name="BtnExecute" Grid.Column="2" Classes="btn-primary" 
                        Padding="16,8" FontWeight="SemiBold"
                        AutomationProperties.Name="Executar Query com Parâmetros">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="▶" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Executar" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>

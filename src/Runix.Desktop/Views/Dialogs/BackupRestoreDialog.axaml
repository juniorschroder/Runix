<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="600"
             x:Class="Runix.Desktop.Views.Dialogs.BackupRestoreDialog"
             Background="#090d14">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- HEADER & MODE SWITCHER -->
        <Border Grid.Row="0" Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#008bb9" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                        <TextBlock Text="💾" FontSize="18"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Gerenciador Integrado de Backup &amp; Restore" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc"/>
                        <TextBlock Name="TxtConnectionSummary" Text="Backup topológico nativo sem dependência de pg_dump ou sqlite3 externos" FontSize="11" Foreground="#8b9cb3"/>
                    </StackPanel>
                </StackPanel>

                <!-- Mode Switcher (Backup vs Restore) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Name="BtnModeBackup" Content="📤 Criar Backup" Classes="btn-primary" Padding="14,7" FontSize="12"
                            AutomationProperties.Name="Modo Criar Backup"/>
                    <Button Name="BtnModeRestore" Content="📥 Restaurar Backup" Classes="btn-secondary" Padding="14,7" FontSize="12"
                            AutomationProperties.Name="Modo Restaurar Backup"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <!-- 1. BACKUP PANEL -->
            <Border Name="PanelBackupMode" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid ColumnDefinitions="1.3*,20,1*">
                    <!-- Left: Format, Scope & Destination -->
                    <StackPanel Grid.Column="0" Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="1. Formato do Backup" FontSize="12" FontWeight="Bold" Foreground="#38bdf8"/>
                            <StackPanel Spacing="6">
                                <RadioButton Name="RbFormatSql" Content="📄 Script SQL Transacional (.sql)" GroupName="BkupFormat" IsChecked="True" Foreground="#f0f6fc" FontSize="12"
                                             AutomationProperties.Name="Formato Script SQL Transacional"/>
                                <RadioButton Name="RbFormatGzip" Content="🗜 Script SQL Compactado GZip (.sql.gz)" GroupName="BkupFormat" Foreground="#f0f6fc" FontSize="12"
                                             AutomationProperties.Name="Formato Script SQL Compactado GZip"/>
                                <RadioButton Name="RbFormatSqliteBin" Content="🗄 Cópia Binária Online SQLite (.db)" GroupName="BkupFormat" Foreground="#f0f6fc" FontSize="12"
                                             AutomationProperties.Name="Formato Cópia Binária Online SQLite"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Name="PanelScopeOptions" Spacing="6">
                            <TextBlock Text="2. Escopo do Conteúdo" FontSize="12" FontWeight="Bold" Foreground="#38bdf8"/>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton Name="RbScopeFull" Content="Completo (DDL + Dados)" GroupName="BkupScope" IsChecked="True" Foreground="#f0f6fc" FontSize="12"
                                             AutomationProperties.Name="Escopo Completo DDL e Dados"/>
                                <RadioButton Name="RbScopeSchema" Content="Apenas Schema" GroupName="BkupScope" Foreground="#f0f6fc" FontSize="12"
                                             AutomationProperties.Name="Escopo Apenas Schema"/>
                                <RadioButton Name="RbScopeData" Content="Apenas Dados" GroupName="BkupScope" Foreground="#f0f6fc" FontSize="12"
                                             AutomationProperties.Name="Escopo Apenas Dados"/>
                            </StackPanel>

                            <CheckBox Name="ChkIncludeDrop" Content="Incluir instruções DROP TABLE IF EXISTS (ordem reversa de FK)" IsChecked="True" Foreground="#cbd5e1" FontSize="11" Margin="0,6,0,0"/>
                            <CheckBox Name="ChkIncludeProg" Content="Incluir Views, Triggers, Functions e Índices" IsChecked="True" Foreground="#cbd5e1" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="3. Arquivo de Destino" FontSize="12" FontWeight="Bold" Foreground="#38bdf8"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Name="TxtBackupOutputPath" Grid.Column="0" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="6,0,0,6" Padding="10,7" FontSize="11"
                                         AutomationProperties.Name="Caminho do arquivo de saída do backup"/>
                                <Button Name="BtnBrowseBackupOutput" Grid.Column="1" Content="Escolher..." Classes="btn-secondary" Padding="12,7" CornerRadius="0,6,6,0" FontSize="11"
                                        AutomationProperties.Name="Escolher arquivo de saída do backup"/>
                            </Grid>
                        </StackPanel>

                        <Button Name="BtnStartBackup" Content="📤 Iniciar Backup Agora" Classes="btn-primary" Padding="18,10" FontSize="13" HorizontalAlignment="Left"
                                AutomationProperties.Name="Iniciar criação do backup"/>
                    </StackPanel>

                    <!-- Right: Table Checklist -->
                    <Grid Grid.Column="2" RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                            <TextBlock Grid.Column="0" Text="Tabelas Incluídas (Ordem Topológica FK)" FontSize="12" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Name="BtnCheckAllTables" Content="Todas" Classes="btn-outline" Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                    AutomationProperties.Name="Selecionar todas as tabelas"/>
                            <Button Grid.Column="2" Name="BtnUncheckAllTables" Content="Nenhuma" Classes="btn-outline" Padding="6,2" FontSize="10"
                                    AutomationProperties.Name="Desmarcar todas as tabelas"/>
                        </Grid>

                        <Border Grid.Row="1" Background="#090d14" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="8">
                            <ListBox Name="ListBackupTables" SelectionMode="Multiple" Background="Transparent" BorderThickness="0"
                                     AutomationProperties.Name="Lista de tabelas incluídas no backup"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. RESTORE PANEL -->
            <Border Name="PanelRestoreMode" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="8" Padding="24" IsVisible="False">
                <StackPanel Spacing="18" MaxWidth="620" HorizontalAlignment="Left">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Restaurar Banco de Dados a partir de Backup" FontSize="14" FontWeight="Bold" Foreground="#f0f6fc"/>
                        <TextBlock Text="Suporta arquivos .sql, .sql.gz (compactados) e .db (binário SQLite). O restore SQL é executado dentro de uma transação atômica com suporte a blocos $$...$$ e triggers."
                                   FontSize="12" Foreground="#8b9cb3" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Arquivo de Backup de Origem (.sql, .sql.gz, .db)" FontSize="12" FontWeight="Bold" Foreground="#38bdf8"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Name="TxtRestoreInputPath" Grid.Column="0" Watermark="/caminho/para/backup.sql.gz" Background="#090d14" Foreground="#f0f6fc" BorderBrush="#1e2d42" CornerRadius="6,0,0,6" Padding="10,8" FontSize="12"
                                     AutomationProperties.Name="Caminho do arquivo de backup de origem"/>
                            <Button Name="BtnBrowseRestoreInput" Grid.Column="1" Content="Procurar Arquivo..." Classes="btn-secondary" Padding="14,8" CornerRadius="0,6,6,0" FontSize="12"
                                    AutomationProperties.Name="Procurar arquivo de backup de origem"/>
                        </Grid>
                    </StackPanel>

                    <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <TextBlock Text="🔒 Segurança Transacional: Se qualquer instrução do script de restore falhar, toda a operação sofre Rollback automático para evitar estado parcial ou corrompido."
                                   FontSize="11" Foreground="#34d399" TextWrapping="Wrap"/>
                    </Border>

                    <Button Name="BtnStartRestore" Content="📥 Executar Restore Transacional" Classes="btn-primary" Padding="20,10" FontSize="13" HorizontalAlignment="Left"
                            AutomationProperties.Name="Executar restauração do backup"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER PROGRESS & DIAGNOSTIC STATUS -->
        <Border Grid.Row="2" Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Name="TxtProgressStatus" Grid.Column="0" Text="Pronto para iniciar backup ou restore." FontSize="12" FontWeight="SemiBold" Foreground="#cbd5e1"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Name="TxtMetricsBadge" Grid.Column="1" Text="" FontSize="11" Foreground="#38bdf8" FontWeight="Bold"
                               AutomationProperties.LiveSetting="Polite"/>
                </Grid>
                <ProgressBar Name="BarBackupProgress" Minimum="0" Maximum="100" Value="0" Height="6" Foreground="#008bb9" Background="#090d14" CornerRadius="3"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="440"
             x:Class="Runix.Desktop.Views.Dialogs.AboutDialog">

    <Border Width="560" Background="#0e141f" BorderBrush="#008bb9" BorderThickness="1.5"
            CornerRadius="12" BoxShadow="0 20 50 8 #D9000000" Padding="0">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- 1. Hero Header Banner -->
            <Border Grid.Row="0" Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0" Padding="22,18">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Brand Icon -->
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="#0064a5"
                            BorderBrush="#38bdf8" BorderThickness="1.5" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title, Version Badge & Tagline -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="RUNIX" FontSize="20" FontWeight="Bold" Foreground="#008bb9" LetterSpacing="1.5" VerticalAlignment="Center"/>
                            <TextBlock Text="Database Studio" FontSize="16" FontWeight="SemiBold" Foreground="#f0f6fc" VerticalAlignment="Center"/>
                            <Border Background="#0c2338" BorderBrush="#38bdf8" BorderThickness="1" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                                <TextBlock Name="TxtVersionBadge" Text="v2.0.0" FontSize="11" FontWeight="Bold" Foreground="#38bdf8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource About.Tagline}" FontSize="11.5" Foreground="#8b9cb3" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Name="BtnClose" Grid.Column="2" Content="✕" Classes="btn-icon" Padding="8,4" FontSize="12" VerticalAlignment="Top"
                            AutomationProperties.Name="{DynamicResource A11y.CloseModal}"/>
                </Grid>
            </Border>

            <!-- 2. Simplified Main Body -->
            <StackPanel Grid.Row="1" Margin="22,18" Spacing="12">
                <!-- Concise Description -->
                <TextBlock Text="{DynamicResource About.Description}" FontSize="12.5" Foreground="#cbd5e1"
                           TextWrapping="Wrap" LineHeight="18"/>

                <!-- Creator Card (Clickable -> LinkedIn) -->
                <Button Name="BtnCreatorLinkedIn" Classes="btn-secondary" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Padding="14,11" CornerRadius="8"
                        AutomationProperties.Name="Abrir perfil do criador no LinkedIn"
                        ToolTip.Tip="https://www.linkedin.com/in/juniorschroder/">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#0c2338"
                                BorderBrush="#38bdf8" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="👨‍💻" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource About.CreatorLabel}" FontSize="9.5" FontWeight="Bold"
                                       Foreground="#38bdf8" LetterSpacing="0.8"/>
                            <TextBlock Name="TxtCreatorName" Text="José Carlos Schröder Júnior" FontSize="14"
                                       FontWeight="Bold" Foreground="#f0f6fc" TextDecorations="Underline"/>
                            <TextBlock Text="linkedin.com/in/juniorschroder" FontSize="11" Foreground="#8b9cb3"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#0c2338" BorderBrush="#16426a" BorderThickness="1"
                                CornerRadius="5" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="LinkedIn ↗" FontSize="10.5" FontWeight="SemiBold" Foreground="#38bdf8"/>
                        </Border>
                    </Grid>
                </Button>

                <!-- Official GitHub Repository Card (Clickable -> GitHub) -->
                <Button Name="BtnGitHubRepo" Classes="btn-secondary" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Padding="14,11" CornerRadius="8"
                        AutomationProperties.Name="Abrir repositório oficial do RUNIX no GitHub"
                        ToolTip.Tip="https://github.com/juniorschroder/Runix">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#090d14"
                                BorderBrush="#1e2d42" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                            <PathIcon Width="18" Height="18" Foreground="#f0f6fc"
                                      Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z"/>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource About.RepositoryLabel}" FontSize="9.5" FontWeight="Bold"
                                       Foreground="#64748b" LetterSpacing="0.8"/>
                            <TextBlock Text="github.com/juniorschroder/Runix" FontSize="13"
                                       FontWeight="Bold" Foreground="#f0f6fc" TextDecorations="Underline"/>
                            <TextBlock Text="{DynamicResource About.RepositoryHint}" FontSize="11" Foreground="#8b9cb3"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1"
                                CornerRadius="5" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="GitHub ↗" FontSize="10.5" FontWeight="SemiBold" Foreground="#cbd5e1"/>
                        </Border>
                    </Grid>
                </Button>

                <!-- Compact System & License Info Bar -->
                <Border Background="#090d14" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="7" Padding="12,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Name="TxtRuntimeBadge" Text=".NET 10.0 • C# 13" FontSize="10" FontWeight="SemiBold" Foreground="#38bdf8" FontFamily="Consolas,Menlo,monospace"/>
                            </Border>
                            <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="Avalonia UI 11.1" FontSize="10" FontWeight="SemiBold" Foreground="#c084fc" FontFamily="Consolas,Menlo,monospace"/>
                            </Border>
                            <Border Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Name="TxtLicenseDetail" Text="GPL-3.0 License" FontSize="10" FontWeight="SemiBold" Foreground="#34d399" FontFamily="Consolas,Menlo,monospace"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Name="TxtOsArch" Grid.Column="1" Text="macOS • Arm64" FontSize="10" Foreground="#64748b"
                                   VerticalAlignment="Center" FontFamily="Consolas,Menlo,monospace"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. Footer Bar -->
            <Border Grid.Row="2" Background="#141d2b" BorderBrush="#1e2d42" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="22,14">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <!-- Status / Feedback Banner (Exibido com destaque, largura total e sem truncar) -->
                    <Border Name="BorderStatusBanner" Grid.Row="0" Margin="0,0,0,12" Padding="12,8" CornerRadius="6"
                            Background="#091829" BorderBrush="#0284c7" BorderThickness="1" IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Name="TxtStatusIcon" Grid.Column="0" Text="ℹ" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="TxtCopyFeedback" Grid.Column="1" Text=""
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#38bdf8"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Grid>
                    </Border>

                    <!-- Linha 1: Botões de Ação com excelente espaçamento horizontal -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                        <Button Name="BtnCheckUpdates" Grid.Column="0" Content="{DynamicResource Update.CheckButton}"
                                Classes="btn-secondary" Padding="12,6" FontSize="11.5"
                                AutomationProperties.Name="Verificar atualizações do RUNIX"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button Name="BtnCopySystemInfo" Content="{DynamicResource About.CopyInfo}"
                                    Classes="btn-secondary" Padding="12,6" FontSize="11.5"
                                    AutomationProperties.Name="Copiar informações do sistema para a área de transferência"/>

                            <Button Name="BtnOk" Content="{DynamicResource Common.Close}"
                                    Classes="btn-primary" Padding="18,6" FontSize="11.5"
                                    AutomationProperties.Name="{DynamicResource Common.Close}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Linha 2: Copyright com linha dedicada, largura total e 100% visível -->
                    <TextBlock Name="TxtCopyrightNotice" Grid.Row="2" Text="© 2026 José Carlos Schröder Júnior"
                               FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:Runix.Core.Models"
             xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:explain="clr-namespace:Runix.Desktop.Views.Explain"
             xmlns:chart="clr-namespace:Runix.Desktop.Views.Chart"
             xmlns:views="clr-namespace:Runix.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Runix.Desktop.Views.QueryTabControl"
             Background="#090d14">

    <Grid RowDefinitions="180,5,*,32">
        <!-- TOP SQL EDITOR AREA -->
        <Grid Grid.Row="0" RowDefinitions="Auto,*" Background="#0e141f">
            <!-- Toolbar -->
            <Border Grid.Row="0" Background="#141d2b" Padding="12,6" BorderBrush="#1e2d42" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Name="BtnRun" Content="{DynamicResource Query.Run}" 
                                    Classes="btn-primary" Padding="14,5" FontSize="11"
                                    AutomationProperties.Name="{DynamicResource A11y.ExecuteSql}"/>
                            <Button Name="BtnExplainPlan" Content="🔍 Explain" 
                                    Classes="btn-secondary" Padding="10,5" FontSize="11"
                                    AutomationProperties.Name="{DynamicResource A11y.ExplainSql}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Name="MenuExplainQuick" Header="🔍 Explain (Estimado) - Ctrl+E"/>
                                        <MenuItem Name="MenuExplainAnalyze" Header="⚡ Explain &amp; Analyze (Métricas Reais)"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Name="BtnClear" Content="{DynamicResource Query.Clear}" 
                                    Classes="btn-outline" Padding="8,5" FontSize="11"
                                    AutomationProperties.Name="Limpar consulta"/>
                            <Button Name="BtnSaveQuery" Content="💾 Salvar" 
                                    Classes="btn-secondary" Padding="10,5" FontSize="11"
                                    AutomationProperties.Name="{DynamicResource A11y.SaveFavoriteSql}"/>
                            <Button Name="BtnFormatSql" Content="✨ Formatar" 
                                    Classes="btn-secondary" Padding="10,5" FontSize="11"
                                    AutomationProperties.Name="{DynamicResource A11y.FormatSql}"
                                    ToolTip.Tip="Formatar SQL (Ctrl+Shift+F)"/>
                            <Button Name="BtnManageSnippets" Content="✂ Snippets" 
                                    Classes="btn-secondary" Padding="10,5" FontSize="11"
                                    AutomationProperties.Name="Gerenciar Snippets de código"/>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Name="TxtExecutionStatus" Grid.Column="1" Text="" 
                               VerticalAlignment="Center" Margin="12,0" Foreground="#8b9cb3" FontSize="11"
                               MaxWidth="200" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite"/>

                    <Button Name="BtnExportData" Grid.Column="2" Content="{DynamicResource Query.Export}" 
                            Classes="btn-secondary" Padding="10,5" FontSize="11"
                            AutomationProperties.Name="{DynamicResource A11y.ExportResults}"/>
                </Grid>
            </Border>

            <!-- Modern AvaloniaEdit SQL Text Editor with line numbers and syntax highlighting -->
            <AvaloniaEdit:TextEditor Name="TxtSqlEditor" Grid.Row="1"
                                     ShowLineNumbers="True"
                                     FontFamily="Consolas,Menlo,Monaco,Courier New,monospace"
                                     FontSize="13"
                                     Background="#090d14"
                                     Foreground="#f0f6fc"
                                     LineNumbersForeground="#475569"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="{DynamicResource A11y.SqlEditor}"/>
        </Grid>

        <!-- SPLITTER -->
        <GridSplitter Grid.Row="1" Background="#1e2d42" ResizeDirection="Rows" HorizontalAlignment="Stretch"/>

        <!-- BOTTOM RESULTS AREA WITH TAB SWITCHER -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" Background="#090d14">
            <!-- Result Tabs Header -->
            <Border Grid.Row="0" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="10,4">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <Button Name="BtnTabResults" Content="📊 Resultados" Classes="btn-secondary" Padding="12,4" FontSize="11"
                                AutomationProperties.Name="Exibir Resultados em Tabela"/>
                        <Button Name="BtnTabChart" Content="📈 Gráfico" Classes="btn-outline" Padding="12,4" FontSize="11"
                                AutomationProperties.Name="Exibir Gráfico"/>
                        <Button Name="BtnTabExplain" Content="⚡ Plano de Execução (Explain)" Classes="btn-outline" Padding="12,4" FontSize="11"
                                AutomationProperties.Name="Exibir Plano de Execução Explain"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Name="BtnToggleQueryFilters" Content="🔍 Filtros por Coluna" Classes="btn-outline" Padding="10,4" FontSize="11"
                                AutomationProperties.Name="Alternar Barra de Filtros por Coluna"
                                ToolTip.Tip="Exibir ou ocultar a barra de filtros rápidos por coluna dos resultados"/>
                        <Button Name="BtnToggleInspector" Content="🔬 Inspetor de Linha" Classes="btn-outline" Padding="10,4" FontSize="11"
                                AutomationProperties.Name="Alternar Inspetor de Linha"
                                ToolTip.Tip="Inspecionar valores JSON, TEXT longos e BLOB da linha selecionada"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tab 1: GridResults + Inspector Drawer -->
            <Grid Name="PanelTabResults" Grid.Row="1" ColumnDefinitions="*,Auto" Background="#090d14">
                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
                    <!-- Sub-Result Sets Toolbar (Aparece apenas quando houver 2 ou mais resultados de consultas) -->
                    <Border Name="BarSubResults" Grid.Row="0" Background="#0c111a" BorderBrush="#1e2d42" BorderThickness="0,0,0,1" Padding="8,4" IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Indicador -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="📑 Resultados:" FontSize="11" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Sub-Tabs Buttons (Gerados dinamicamente para cada SELECT) -->
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Name="PanelSubResultButtons" Orientation="Horizontal" Spacing="4"/>
                            </ScrollViewer>

                            <!-- Alternador de Layout: Sub-Abas vs Painéis Divididos (Split) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Name="BtnSubLayoutTabs" Content="📑 Sub-Abas" Classes="btn-secondary" Padding="8,3" FontSize="10.5"
                                        ToolTip.Tip="Exibir uma consulta por vez em tela cheia"/>
                                <Button Name="BtnSubLayoutSplit" Content="◫ Dividido" Classes="btn-outline" Padding="8,3" FontSize="10.5"
                                        ToolTip.Tip="Exibir todos os resultados divididos simultaneamente na tela"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Query Results Inline Column Filters Bar (Oculto por default ao executar consultas) -->
                    <Border Name="BarQueryColumnFilters" Grid.Row="1" Background="#0b1726" BorderBrush="#0284c7" BorderThickness="0,0,0,1" Padding="12,10,12,12" IsVisible="False">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="🔍 Filtros Rápidos por Coluna:" FontSize="11.5" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                                    <TextBlock Text="(ex: > 100, LIKE '%abc%', IS NULL)" FontSize="10.5" Foreground="#64748b" VerticalAlignment="Center"/>
                                    <Border Name="BadgeQueryActiveFilters" Background="#064e3b" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="4,0,0,0" IsVisible="False">
                                        <TextBlock Name="TxtQueryActiveFiltersCount" Text="0 ativos" FontSize="9.5" FontWeight="Bold" Foreground="#34d399"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Name="BtnApplyQueryFilters" Content="Filtrar" Classes="btn-primary" Padding="12,4" FontSize="11"
                                            AutomationProperties.Name="Aplicar Filtros nas Colunas"/>
                                    <Button Name="BtnClearQueryFilters" Content="Limpar Filtros" Classes="btn-outline" Padding="10,4" FontSize="11"
                                            AutomationProperties.Name="Limpar Filtros das Colunas"/>
                                </StackPanel>
                            </Grid>

                            <!-- Scrollable Row of Column Filter TextBoxes com respiro adequado para a barra de rolagem horizontal -->
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,16">
                                <StackPanel Name="PanelQueryFiltersHost" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Content Container for Grid(s) -->
                    <Grid Grid.Row="2">
                        <!-- Progress Bar while query is executing -->
                        <ProgressBar Name="ProgressExecuting" Height="3" IsIndeterminate="True" IsVisible="False" 
                                     Foreground="#008bb9" Background="#0e141f" VerticalAlignment="Top" ZIndex="10"/>

                        <!-- Modo 1: Single Grid / Sub-Tab Ativa -->
                        <DataGrid Name="GridResults" AutoGenerateColumns="False" IsReadOnly="True" 
                                  GridLinesVisibility="All" HeadersVisibility="Column"
                                  BorderThickness="0" Background="#090d14" Foreground="#f0f6fc"
                                  RowBackground="#0c111a"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="{DynamicResource A11y.QueryResultsGrid}">
                            <DataGrid.ContextMenu>
                                <ContextMenu Name="MenuQueryResultCell">
                                    <MenuItem Name="MenuQueryFilterByCellValue" Header="🔍 Filtrar por este Valor"/>
                                    <MenuItem Name="MenuQueryCopyCellValue" Header="📋 Copiar Valor da Célula"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>

                        <!-- Modo 2: Split Grids Container (Painéis Divididos Empilhados) -->
                        <ScrollViewer Name="ContainerSplitGrids" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="False">
                            <StackPanel Name="PanelSplitGridsHost" Spacing="10" Margin="4,4,4,4"/>
                        </ScrollViewer>

                        <!-- Empty State / Placeholder -->
                        <Border Name="BorderPlaceholder" Background="#090d14" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="⚡" FontSize="36" HorizontalAlignment="Center" Foreground="#336791"/>
                                <TextBlock Text="{DynamicResource Query.PlaceholderTitle}" FontSize="14" Foreground="#8b9cb3" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Query.PlaceholderHint}" FontSize="11" Foreground="#5a6f87" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <views:RecordInspectorDrawer Name="DrawerInspector" Grid.Column="1" Width="340" IsVisible="False"/>
            </Grid>

            <!-- Tab 2: SkiaChartControl -->
            <chart:SkiaChartControl Name="ViewChart" Grid.Row="1" IsVisible="False"/>

            <!-- Tab 3: ExplainPlanView -->
            <explain:ExplainPlanView Name="ViewExplainPlan" Grid.Row="1" IsVisible="False"/>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,1,0,0" Padding="14,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="TxtRowStats" Text="0 rows" VerticalAlignment="Center" FontSize="11" Foreground="#8b9cb3"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Name="TxtTimeStats" Grid.Column="1" Text="" VerticalAlignment="Center" FontSize="11" Foreground="#008bb9"
                           AutomationProperties.LiveSetting="Polite"/>
            </Grid>
        </Border>

        <!-- MODAL OVERLAY HOST FOR SAVE QUERY / SNIPPETS -->
        <Grid Name="PanelModalOverlay" Grid.RowSpan="4" Background="#b0000000" IsVisible="False" ZIndex="100">
            <ContentControl Name="ModalContainer" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
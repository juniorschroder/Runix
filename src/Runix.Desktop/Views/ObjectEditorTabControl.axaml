<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
             x:Class="Runix.Desktop.Views.ObjectEditorTabControl"
             Background="#090d14">

    <Grid RowDefinitions="Auto,*,5,190,32">
        <!-- HEADER / ACTION TOOLBAR -->
        <Border Grid.Row="0" Background="#141d2b" Padding="14,8" BorderBrush="#1e2d42" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Object Metadata & Template Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Name="BadgeType" Background="#008bb9" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Name="TxtTypeBadge" Text="VIEW" FontSize="10" FontWeight="Bold" Foreground="#ffffff"/>
                    </Border>
                    <TextBlock Name="TxtObjectTitle" Text="v_active_users" FontSize="14" FontWeight="Bold" Foreground="#f0f6fc" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtObjectSubtitle" Text="" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center" Margin="4,0,0,0"/>

                    <!-- Template Switcher (Visible when creating a new object) -->
                    <StackPanel Name="PanelTemplateSelector" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" IsVisible="False" VerticalAlignment="Center">
                        <TextBlock Text="Tipo:" FontSize="11" Foreground="#8b9cb3" VerticalAlignment="Center"/>
                        <ComboBox Name="CmbObjectType" Width="130" FontSize="11" SelectedIndex="0">
                            <ComboBoxItem Content="👁️ View"/>
                            <ComboBoxItem Content="⚡ Trigger"/>
                            <ComboBoxItem Content="📇 Index"/>
                            <ComboBoxItem Content="ƒ Function (PG)"/>
                            <ComboBoxItem Content="⚙️ Procedure (PG)"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <!-- Right: DDL Lifecycle Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Name="BtnApplyDdl" Content="💾 Aplicar DDL (Ctrl+S)" Classes="btn-primary" Padding="12,5" FontSize="11"
                            ToolTip.Tip="Aplica a definição DDL de forma transacional no banco de dados"/>
                    <Button Name="BtnPreviewData" Content="▶ Consultar View" Classes="btn-secondary" Padding="10,5" FontSize="11"
                            ToolTip.Tip="Executa SELECT * LIMIT 100 nesta View para inspecionar o resultado"/>
                    <Button Name="BtnFormatDdl" Content="✨ Formatar" Classes="btn-secondary" Padding="10,5" FontSize="11"
                            ToolTip.Tip="Formatar definição DDL (Ctrl+Shift+F)"/>
                    <Button Name="BtnCopyDdl" Content="📋 Copiar DDL" Classes="btn-secondary" Padding="10,5" FontSize="11"/>
                    <Button Name="BtnReloadDdl" Content="🔄 Restaurar" Classes="btn-outline" Padding="10,5" FontSize="11"
                            ToolTip.Tip="Recarrega a definição original salva no catálogo do banco"/>
                    <Button Name="BtnDropObject" Content="🗑 Excluir" Classes="btn-danger" Padding="10,5" FontSize="11"
                            ToolTip.Tip="Remove este objeto do banco de dados (DROP)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DDL EDITOR (AVALONIAEDIT) -->
        <Grid Grid.Row="1" Background="#090d14">
            <AvaloniaEdit:TextEditor Name="TxtDdlEditor"
                                     Background="#090d14"
                                     Foreground="#f0f6fc"
                                     FontFamily="Consolas,Menlo,Monaco,monospace"
                                     FontSize="13"
                                     ShowLineNumbers="True"
                                     Padding="12,10"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- SPLITTER -->
        <GridSplitter Grid.Row="2" Background="#1e2d42" ResizeDirection="Rows" HorizontalAlignment="Stretch"/>

        <!-- BOTTOM PREVIEW / DIAGNOSTICS PANEL -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*" Background="#0e141f">
            <Border Grid.Row="0" Background="#141d2b" Padding="12,5" BorderBrush="#1e2d42" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Name="TxtPreviewHeader" Text="📋 Diagnóstico &amp; Preview de Dados" FontSize="11" FontWeight="SemiBold" Foreground="#38bdf8"/>
                    <TextBlock Name="TxtSafeModeHint" Grid.Column="1" Text="🔒 Execução Transacional Atômica Ativa (Rollback automático em erro)" FontSize="10" Foreground="#34d399"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- Status / Error Message Box -->
                <Border Name="BorderDiagnosticMessage" Padding="14,10" IsVisible="True">
                    <TextBlock Name="TxtDiagnosticMessage"
                               Text="Edite a definição DDL acima e clique em 'Aplicar DDL (Ctrl+S)' para atualizar o objeto no banco."
                               Foreground="#8b9cb3" FontSize="12" TextWrapping="Wrap"
                               FontFamily="Consolas,Menlo,monospace"/>
                </Border>

                <!-- Preview DataGrid (for Views) -->
                <DataGrid Name="GridPreview" IsVisible="False" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="All" BorderThickness="0" Background="#090d14" RowBackground="#0e141f"/>
            </Grid>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="4" Background="#0e141f" BorderBrush="#1e2d42" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="TxtFooterStatus" Grid.Column="0" Text="Pronto" VerticalAlignment="Center" FontSize="11" Foreground="#8b9cb3"/>
                <TextBlock Name="TxtDialectBadge" Grid.Column="1" Text="SQLite" VerticalAlignment="Center" FontSize="11" Foreground="#38bdf8" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
